{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "qa-sdet:qa-explorer|qa-explorer|qa-sdet:qa-mapper|qa-mapper",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/qa-mem\" ingest-pending qa-out \"$CLAUDE_PROJECT_DIR/qa-out\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/qa-mem\" ingest-pending qa-out \"$CLAUDE_PROJECT_DIR/qa-out\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
