#!/usr/bin/env python3
"""qa-mem: compact SQLite memory of the app under test.

Agents read it (card/search/bugs/hash/code). Knowledge is written only by `ingest`, which the plugin's
Stop/SubagentStop hook runs on every changed qa-out/**/run.json, and by the code map: `codemap-scan` lists
source files deterministically, the qa-mapper agent writes qa-out/init/code-map-<area>.json, and the same
hook ingests it into the `codemap` table (hints from source, never requirements). The user's manual writes
are `bug-status` and `stale`.

v0.4 run folders (qa-out/<date>-<label>/): `rundir` makes one, explorers write .data/run-<slug>.json (ingested
like run.json), and `report` renders REPORT.md + qa-out/README.md from .data/plan.json and those files.
Wrappers (`marker`, `browser-open`, `prune`, `annotate`, `setup-permissions`) keep skill commands to one shape.
"""
import hashlib
import json
import subprocess
import os
import re
import sqlite3
import stat
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import quote, urlsplit

try:
    import fcntl
except ImportError:  # shortcut: no file lock on Windows; fine while one session runs QA at a time
    fcntl = None

CONFIG = Path(os.environ.get("QA_SDET_CONFIG", "~/.config/qa-sdet/config.json")).expanduser()
DATA_DIR = Path(os.environ.get("QA_SDET_DATA", "~/.local/share/qa-sdet")).expanduser()
MAX_TEXT = 300
MAX_FACTS, MAX_COVERAGE, MAX_RUNS = 100, 400, 2000  # per page, per page, total
UNKNOWN = "unknown"
STATUSES = {"OPEN", "FILED", "FIXED", "INVALID", "REGRESSED"}
BROWSERS = ("chrome", "msedge", "firefox", "webkit")  # playwright-cli / Playwright MCP --browser values
VISIBLE = ("OPEN", "FILED", "REGRESSED")  # bugs the explorer must know about
# Must match the IDs in references/heuristics.md.
HEURISTICS = [
    "happy-path", "boundary", "empty-null", "invalid-format", "unicode-whitespace",
    "duplicate", "sequence-repeat", "back-refresh", "sort-filter-paginate",
    "error-handling", "loading-empty-states", "keyboard-a11y", "console-errors",
    "network-failures", "permissions",
]

SCHEMA = """
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS pages(route TEXT PRIMARY KEY, name TEXT, build TEXT, last_verified TEXT);
CREATE TABLE IF NOT EXISTS facts(id INTEGER PRIMARY KEY, page TEXT NOT NULL, kind TEXT NOT NULL,
  text TEXT NOT NULL, source TEXT, build TEXT, ts TEXT, stale INTEGER DEFAULT 0, UNIQUE(page, kind, text));
CREATE INDEX IF NOT EXISTS facts_page ON facts(page, kind);
CREATE VIRTUAL TABLE IF NOT EXISTS facts_fts USING fts5(text, content='facts', content_rowid='id');
CREATE TRIGGER IF NOT EXISTS facts_ai AFTER INSERT ON facts BEGIN
  INSERT INTO facts_fts(rowid, text) VALUES (new.id, new.text); END;
CREATE TRIGGER IF NOT EXISTS facts_ad AFTER DELETE ON facts BEGIN
  INSERT INTO facts_fts(facts_fts, rowid, text) VALUES ('delete', old.id, old.text); END;
CREATE TABLE IF NOT EXISTS locators(page TEXT, name TEXT, locator TEXT, build TEXT,
  last_verified TEXT, stale INTEGER DEFAULT 0, PRIMARY KEY(page, name));
CREATE TABLE IF NOT EXISTS coverage(page TEXT, target TEXT, heuristic TEXT, result TEXT, build TEXT,
  run_id TEXT, ts TEXT, PRIMARY KEY(page, target, heuristic, build));
CREATE INDEX IF NOT EXISTS coverage_page ON coverage(page, build);
CREATE TABLE IF NOT EXISTS bugs(hash TEXT PRIMARY KEY, page TEXT, title TEXT, severity TEXT,
  classification TEXT, status TEXT DEFAULT 'OPEN', draft_path TEXT, first_seen TEXT, last_seen TEXT,
  seen_count INTEGER DEFAULT 1, last_run TEXT, symptom TEXT);
CREATE INDEX IF NOT EXISTS bugs_page ON bugs(page, status);
CREATE TABLE IF NOT EXISTS sightings(run_id TEXT, src TEXT, hash TEXT, PRIMARY KEY(run_id, src, hash));
CREATE TABLE IF NOT EXISTS runs(id TEXT PRIMARY KEY, mode TEXT, target TEXT, build TEXT, status TEXT,
  summary TEXT, ts TEXT);
CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY, value TEXT);
CREATE TABLE IF NOT EXISTS codemap(page TEXT NOT NULL, kind TEXT NOT NULL, label TEXT NOT NULL, value TEXT,
  file TEXT, repo TEXT NOT NULL, area TEXT NOT NULL, ts TEXT, src TEXT NOT NULL DEFAULT '',
  PRIMARY KEY(page, kind, label, repo, area, src));
CREATE INDEX IF NOT EXISTS codemap_page ON codemap(page, kind);
"""


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def db_path():
    if os.environ.get("QA_MEM_DB"):
        return Path(os.environ["QA_MEM_DB"])
    app = "default"
    try:
        app = str(json.loads(CONFIG.read_text()).get("app") or app)
    except FileNotFoundError:
        pass
    except (ValueError, OSError, AttributeError) as e:
        print(f"qa-mem: ignoring unreadable {CONFIG}: {e}", file=sys.stderr)
    return DATA_DIR / f"{re.sub(r'[^A-Za-z0-9_.-]', '_', app)}.db"


def connect():
    p = db_path()
    p.parent.mkdir(mode=0o700, parents=True, exist_ok=True)  # app facts and bugs: owner only
    con = sqlite3.connect(p, timeout=10)
    con.row_factory = sqlite3.Row
    old = {r[1] for r in con.execute("PRAGMA table_info(codemap)")}
    if old and "src" not in old:  # a code map from before rows were keyed by file: re-derivable, so rebuild it
        con.execute("DROP TABLE codemap")
        con.execute("DELETE FROM meta WHERE key LIKE 'codemap_%'")
        con.commit()
    con.executescript(SCHEMA)
    cols = {r[1] for r in con.execute("PRAGMA table_info(bugs)")}
    for col in ("last_run", "symptom"):  # migrations for DBs made by older versions
        if col not in cols:
            con.execute(f"ALTER TABLE bugs ADD COLUMN {col} TEXT")
    # facts_fts reads its text from `facts`, so count what is actually indexed (its docsize shadow table):
    # facts from before the index existed must be indexed, or a later delete corrupts it.
    if con.execute("SELECT count(*) FROM facts").fetchone()[0] != con.execute(
            "SELECT count(*) FROM facts_fts_docsize").fetchone()[0]:
        con.execute("INSERT INTO facts_fts(facts_fts) VALUES('rebuild')")
        con.commit()
    return con


def txt(v, field):
    """Scalar field as str (or None). Lists/dicts are a bad run.json, not a transient error."""
    if v is None:
        return None
    if isinstance(v, bool) or not isinstance(v, (str, int, float)):
        raise ValueError(f"'{field}' must be a string")
    return str(v)


def norm_route(r):
    """'/form.html', 'http://host/form.html?x=1', '/form.html/' -> '/form.html'. Keeps SPA hash routes (#/..., #!/...)."""
    r = str(r or "").strip()
    if not r:
        return ""
    try:
        parts = urlsplit(r if "://" in r else "http://x" + ("" if r.startswith(("/", "#")) else "/") + r)
    except ValueError:  # 'http://[x': no route in it (ingest then reports the missing route; card finds no page)
        return ""
    path = _ids(parts.path) or "/"
    f = parts.fragment.split("?")[0]
    bang = "!" if f.startswith("!/") else ""  # AngularJS hashbang routes: #!/incidents
    frag = _ids(f[len(bang):]) if f[len(bang):].startswith("/") else ""
    return path + (f"#{bang}{frag}" if frag else "")


ID_SEGMENT = re.compile(r"\d+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{16,}|"
                        r":\w+|\{\w+\}|\[\.{0,3}\w+\]|<[^/>]+>|\$\{[^}/]*\}", re.I)  # route params: :id, {id}, [id], <id>


def _ids(path):
    """'/incidents/4521//' -> '/incidents/:id': one card and one bug hash for every record's detail page."""
    segs = [":id" if ID_SEGMENT.fullmatch(x) else x for x in (y.strip() for y in path.split("/")) if x]
    return ("/" + "/".join(segs)) if segs else ""


def cap(s):
    return " ".join(str(s or "").split())[:MAX_TEXT]


def norm(s):
    return " ".join(re.sub(r"[^a-z0-9]+", " ", str(s or "").lower()).split())


def bug_hash(route, symptom):
    return hashlib.sha1(f"{norm(route)}|{norm(symptom)}".encode()).hexdigest()[:12]


def meta(con, key):
    row = con.execute("SELECT value FROM meta WHERE key=?", (key,)).fetchone()
    return row[0] if row else None


def set_meta(con, key, value):
    con.execute("INSERT OR REPLACE INTO meta VALUES(?, ?)", (key, value))


def dicts(obj, key):
    items = obj.get(key) or []
    if not isinstance(items, list) or not all(isinstance(i, dict) for i in items):
        raise ValueError(f"'{key}' must be a list of objects")
    return items


def heuristic_id(h):
    h = norm(h).replace(" ", "-")
    return h if h in HEURISTICS else f"other:{h}"


def coverage_result(r):
    """pass / fail / blocked, whatever the agent wrote: 'BLOCKED (needs --faults)', NOT_RUN and skipped
    mean not done, so the heuristic stays UNTRIED; anything else is kept short as written."""
    w = norm(r).split()
    if not w or w[0] in ("pass", "passed", "ok", "covered", "done"):
        return "pass"
    if w[0] in ("fail", "failed", "failure", "bug"):
        return "fail"
    if w[0] in ("blocked", "skipped", "skip", "untested", "na", "not", "notrun", "none", "pending", "question"):
        return "blocked"
    return cap(r)[:20]


def resolve_draft(path, run_dir):
    """Absolute draft path: the DB is per app and shared by projects, so relative paths would be ambiguous.
    Relative paths are tried against the project (parent of qa-out/) and then the run folder."""
    if not path:
        return None  # "" from a re-sighting must not wipe the draft path the DB already has
    if run_dir is None:
        return str(path)
    p = Path(str(path)).expanduser()
    if p.is_absolute():
        return str(p)
    run_dir = Path(run_dir).resolve()
    tries = [run_dir / p]
    if run_dir.name == ".data":  # qa-out/<run>/.data/run-<slug>.json: drafts sit in qa-out/<run>/bugs/
        tries.insert(0, run_dir.parent / p)
    for anc in (run_dir, *run_dir.parents):
        if anc.name == "qa-out":
            tries.insert(0, anc.parent / p)
            break
    return str(next((t for t in tries if t.exists()), tries[0]))


def ingest(con, run, ts=None, run_dir=None, src=""):
    """Upsert one run.json dict. ts = when the run finished (file mtime); run_dir = folder of the run.json;
    src = the file it came from (a rewrite of that file replaces its bugs).
    Raises ValueError on bad shape."""
    if not isinstance(run, dict):
        raise ValueError("run.json must be an object")
    if not run.get("run_id"):
        raise ValueError("run.json missing 'run_id'")
    # Same build text however the page laid it out ("Build:\n 1.42" == "Build: 1.42"); capped like all text.
    # An empty or missing build (empty version element) is unknown, not a broken run.
    build, rid, ts = cap(txt(run.get("build"), "build")), txt(run["run_id"], "run_id"), ts or now()
    b = build.lower().strip(" .:()[]'\"")
    if b in ("", "n/a", "na", "none", "null", "undefined", "?", "-", "not found") or b.startswith(UNKNOWN):
        build = UNKNOWN  # couldn't read the build ('undefined' from ?.textContent, 'unknown (...)'): stale nothing
    known = build.lower() != UNKNOWN
    for f in ("mode", "target", "status", "summary"):
        txt(run.get(f), f)
    pages, bug_list = dicts(run, "pages"), dicts(run, "bugs")
    for pg in pages:
        pg["route"] = norm_route(txt(pg.get("route"), "route"))
        if not pg["route"]:
            raise ValueError("page entry missing 'route'")
        txt(pg.get("name"), "name")
        for key, fields in (("facts", ("kind", "text", "source")), ("locators", ("name", "locator")),
                            ("coverage", ("target", "heuristic", "result"))):
            for item in dicts(pg, key):
                for f in fields:
                    txt(item.get(f), f"{key}.{f}")
    check_report_fields(run)
    for b in bug_list:
        for f in ("title", "symptom", "severity", "classification", "draft_path", "hash", "route", "evidence", "ticket"):
            txt(b.get(f), f"bugs.{f}")
        if b.get("annotated") is not None and not isinstance(b["annotated"], bool):
            raise ValueError("'bugs.annotated' must be true or false")
        if not b.get("title") or not b.get("route"):
            raise ValueError("bug entry needs 'title' and 'route'")
        b["route"] = norm_route(b["route"])
    with con:
        con.execute("INSERT OR REPLACE INTO runs VALUES(?,?,?,?,?,?,?)",
                    (rid, cap(run.get("mode")) or None, cap(run.get("target")), build, cap(run.get("status")) or None,
                     cap(run.get("summary")), ts))
        # The deployed build only moves forward in time: an old run.json ingested late must not roll it back.
        if known and (meta(con, "build_ts") or "") <= ts:
            set_meta(con, "build", build)
            set_meta(con, "build_ts", ts)
        for pg in pages:
            route = pg["route"]
            old = con.execute("SELECT build, last_verified FROM pages WHERE route=?", (route,)).fetchone()
            # A run older than what we already know (ingested late) must not roll the page back.
            late = bool(old and old["last_verified"] and ts < old["last_verified"])
            # A late file of the page's current build still saw the current page: its new facts and locators count.
            same_build = bool(known and old and old["build"] == build)
            current = known and (not late or same_build)
            if known and not late and old and old["build"] not in (build, UNKNOWN, None):  # new build: re-verify
                con.execute("UPDATE facts SET stale=1 WHERE page=?", (route,))
                con.execute("UPDATE locators SET stale=1 WHERE page=?", (route,))
            if late:
                con.execute("INSERT OR IGNORE INTO pages(route, name, build) VALUES(?,?,?)", (route, None, build))
            elif known:
                con.execute("INSERT INTO pages VALUES(?,?,?,?) ON CONFLICT(route) DO UPDATE SET "
                            "name=coalesce(excluded.name, name), build=excluded.build, "
                            "last_verified=excluded.last_verified",
                            (route, cap(pg.get("name")) or None, build, ts))
            else:  # e.g. a plan from a ticket: knows the page, verified nothing
                con.execute("INSERT INTO pages(route, name, build) VALUES(?,?,?) ON CONFLICT(route) DO UPDATE "
                            "SET name=coalesce(name, excluded.name), build=coalesce(build, excluded.build)",
                            (route, cap(pg.get("name")) or None, UNKNOWN))
            for f in pg.get("facts") or []:
                text = cap(f.get("text"))
                if text:
                    # Only a verifying run (known build, not late) refreshes an existing fact.
                    con.execute("INSERT INTO facts(page,kind,text,source,build,ts,stale) VALUES(?,?,?,?,?,?,?) "
                                "ON CONFLICT(page,kind,text) DO UPDATE SET "
                                "source=CASE WHEN ? AND lower(coalesce(excluded.source, '')) = 'observed' "
                                "THEN 'observed' ELSE source END, "  # a ticket rule the explorer has now seen
                                "stale=CASE WHEN ? THEN 0 ELSE stale END, "
                                "build=CASE WHEN ? THEN excluded.build ELSE build END, "
                                "ts=CASE WHEN ? THEN excluded.ts ELSE ts END",
                                (route, cap(f.get("kind"))[:30] or "note", text, cap(f.get("source")), build, ts,
                                 int(late and not same_build), int(current), int(current),
                                 *(int(known and not late),) * 2))
            for loc in pg.get("locators") or []:
                # A truncated locator would be broken, so skip oversized ones instead of capping.
                if (not late or same_build) and loc.get("name") and loc.get("locator") \
                        and len(str(loc["locator"])) <= MAX_TEXT:  # late + same build: add, never replace newer
                    con.execute(f"INSERT OR {'IGNORE' if late else 'REPLACE'} INTO locators VALUES(?,?,?,?,?,0)",
                                (route, cap(loc["name"]), str(loc["locator"]).strip(), build, ts))
            for c in pg.get("coverage") or []:
                if c.get("heuristic"):
                    # the newest run's result stands: a run.json ingested late must not put its older one back
                    con.execute("INSERT INTO coverage VALUES(?,?,?,?,?,?,?) ON CONFLICT(page,target,heuristic,build) "
                                "DO UPDATE SET result=excluded.result, run_id=excluded.run_id, ts=excluded.ts "
                                "WHERE excluded.ts >= coalesce(coverage.ts, '')",
                                (route, cap(c.get("target")) or "*", heuristic_id(c["heuristic"]),
                                 coverage_result(c.get("result")), build, rid, ts))
        for pg in pages:  # size caps: keep the freshest knowledge per page
            con.execute("DELETE FROM facts WHERE page=? AND id NOT IN (SELECT id FROM facts WHERE page=? "
                        "ORDER BY stale, ts DESC LIMIT ?)", (pg["route"], pg["route"], MAX_FACTS))
            con.execute("DELETE FROM coverage WHERE page=? AND rowid NOT IN (SELECT rowid FROM coverage WHERE page=? "
                        "ORDER BY ts DESC LIMIT ?)", (pg["route"], pg["route"], MAX_COVERAGE))
            con.execute("DELETE FROM locators WHERE page=? AND name NOT IN (SELECT name FROM locators WHERE page=? "
                        "ORDER BY stale, last_verified DESC LIMIT 60)", (pg["route"], pg["route"]))
        con.execute("DELETE FROM runs WHERE id NOT IN (SELECT id FROM runs ORDER BY ts DESC LIMIT ?)", (MAX_RUNS,))
        con.execute("DELETE FROM sightings WHERE run_id NOT IN (SELECT id FROM runs)")
        # sightings = which bugs this run file reported. A rewritten run.json (or a sibling's hook ingesting it
        # mid-run) replaces its earlier version: a bug it no longer lists is un-sighted (dropped when only it ever
        # saw it), and seen_count counts distinct run ids even when runs are re-ingested interleaved.
        src = str(src or "")
        before = {r[0] for r in con.execute("SELECT hash FROM sightings WHERE run_id=? AND src=?", (rid, src))}
        ran = lambda h: con.execute("SELECT 1 FROM sightings WHERE run_id=? AND hash=?", (rid, h)).fetchone()
        now_seen = set()
        for b in bug_list:
            symptom = cap(b.get("symptom") or b["title"])
            raw = str(b.get("hash") or "").strip()
            if re.fullmatch(r"[A-Za-z][A-Za-z0-9]*-\d+", raw) and not re.fullmatch(r"(?i)BUG-\d+", raw):
                continue  # a Jira key: a bug tracked in Jira, not a local one to create (BUG-n is a draft's id: created)
            m = re.match(r"#?\s*([0-9a-fA-F]{4,12})\b", raw)  # '<hash> ', '#<hash>', '<hash> (known)'
            given = m.group(1).lower() if m else ""  # 'n/a', 'TBD', 'new': no hash, so the bug is created
            h = None
            if given:  # re-sighting of a known bug (prefix ok if unique)
                hits = con.execute("SELECT hash FROM bugs WHERE substr(hash,1,?)=?", (len(given), given)).fetchall()
                h = hits[0][0] if len(hits) == 1 else None
            h = h or bug_hash(b["route"], symptom)
            # a new sighting counts once; a bug from before sightings existed counts this run via last_run
            fresh = int(not ran(h) and not con.execute(
                "SELECT 1 FROM bugs WHERE hash=? AND last_run=?", (h, rid)).fetchone())
            now_seen.add(h)
            con.execute("INSERT OR IGNORE INTO sightings VALUES(?,?,?)", (rid, src, h))
            # a FIXED bug seen again by another run becomes REGRESSED.
            con.execute("INSERT INTO bugs(hash,page,title,severity,classification,draft_path,first_seen,"
                        "last_seen,last_run,symptom) VALUES(?,?,?,?,?,?,?,?,?,?) ON CONFLICT(hash) DO UPDATE SET "
                        "seen_count=seen_count + ?, "
                        # a run older than the last sighting (ingested late) predates the fix: no regression, no last_run
                        "status=CASE WHEN status='FIXED' AND ? AND excluded.last_seen >= coalesce(last_seen, '') "
                        "THEN 'REGRESSED' ELSE status END, "
                        "last_run=CASE WHEN excluded.last_seen >= coalesce(last_seen, '') THEN excluded.last_run ELSE last_run END, "
                        "last_seen=max(coalesce(last_seen, ''), excluded.last_seen), "
                        "first_seen=min(coalesce(first_seen, excluded.first_seen), excluded.first_seen), "
                        "severity=coalesce(excluded.severity, severity), "
                        "classification=coalesce(excluded.classification, classification), "
                        "draft_path=coalesce(excluded.draft_path, draft_path), "
                        "symptom=coalesce(symptom, excluded.symptom)",
                        (h, b.get("route"), cap(b["title"]), cap(b.get("severity"))[:20] or None,
                         cap(b.get("classification"))[:20] or None,
                         resolve_draft(b.get("draft_path"), run_dir), ts, ts, rid, symptom, fresh, fresh))
        for h in before - now_seen:  # listed by an earlier version of this run.json only
            con.execute("DELETE FROM sightings WHERE run_id=? AND src=? AND hash=?", (rid, src, h))
            if ran(h):
                continue  # another file of the same run id still lists it
            con.execute("UPDATE bugs SET seen_count=max(seen_count - 1, 0), "
                        "last_run=CASE WHEN last_run=? THEN NULL ELSE last_run END WHERE hash=?", (rid, h))
            # only this run ever saw it and the user hasn't triaged it: it was never a bug
            con.execute("DELETE FROM bugs WHERE hash=? AND seen_count=0 AND status='OPEN' AND NOT EXISTS "
                        "(SELECT 1 FROM sightings WHERE hash=?)", (h, h))


CASE_STATUSES = ("PASS", "FAIL", "BLOCKED", "NOT_RUN", "QUESTION")


def case_status(v):
    """'pass', 'Not run', 'not-run' -> PASS / NOT_RUN; None when it isn't one of CASE_STATUSES."""
    s = re.sub(r"[\s-]+", "_", str(v or "").strip().upper())
    return s if s in CASE_STATUSES else None


def check_report_fields(run):
    """Types of the fields only the report reads (cases, questions, not_tested, notes, env). Raises ValueError."""
    for c in dicts(run, "cases"):
        if not txt(c.get("id"), "cases.id"):
            raise ValueError("every case needs an 'id' (TC-n from the plan)")
        for f in ("status", "actual", "notes", "bug"):
            txt(c.get(f), f"cases.{f}")
        if not case_status(c.get("status")):
            raise ValueError(f"case {c['id']}: 'status' must be one of {', '.join(CASE_STATUSES)}")
    for key in ("questions", "not_tested"):
        items = run.get(key) or []
        if not isinstance(items, list) or not all(isinstance(i, str) for i in items):
            raise ValueError(f"'{key}' must be a list of strings")
    txt(run.get("notes"), "notes")
    env = run.get("env") or {}
    if not isinstance(env, dict):
        raise ValueError("'env' must be an object")
    for f in ("url", "browser"):
        txt(env.get(f), f"env.{f}")


def ingest_pending(root):
    """Scrub the qa-out tree, then ingest every run.json that changed since its last ingest. Never raises.
    Touches nothing when root doesn't exist, and no DB when there is no run.json (the hook runs everywhere)."""
    root = Path(root)
    if not root.is_dir():
        return 0
    scrub_tree(root)
    pending = _pending(root)
    if not pending:  # the common case on every Stop: nothing new, so no DB, no lock
        return 0
    db = db_path()
    db.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with open(db.with_suffix(".lock"), "w") as lock:
        if fcntl:
            fcntl.flock(lock, fcntl.LOCK_EX)  # Stop and SubagentStop may fire together; also guards migrations
        con = connect()
        try:
            return _ingest_files(con, pending)
        finally:
            con.close()


# ---------- redaction: secrets must not reach drafts the user files, or the DB ----------
SECRET_HEADERS = ("authorization|proxy-authorization|cookie|set-cookie|x-api-key|x-auth-token|x-csrf-token|"
                  "x-xsrf-token|x-amz-security-token")
# Any name ending in one of these (PRIVATE_TOKEN, secret_key, bearerToken); not 'sid': site/segment IDs.
SECRET_KEYS = ("[A-Za-z0-9_-]{0,40}?(?:password|passwd|pwd|secret|token|api[ _-]?key|private[ _-]?key|secret[ _-]?key|"
               "access[ _-]?key|account[ _-]?key|subscription[ _-]?key)|session[ _-]?id")  # also 'API key', 'Session ID'
SECRET_NAME_RE = re.compile(rf"(?i)^({SECRET_HEADERS}|{SECRET_KEYS}|jsessionid|phpsessid|asp\.net_sessionid|jwt|"
                            rf"bearer)$")  # as a JSON key or header name only; in prose these are ordinary words
# Literal tokens: safe to replace anywhere, including inside code and JSON strings.
LITERAL_REDACTIONS = [
    (re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]*"), "[REDACTED-JWT]"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "[REDACTED-AWS-KEY]"),
    (re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}\b"), "[REDACTED-GITHUB-TOKEN]"),
    (re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}"), "[REDACTED-SLACK-TOKEN]"),
    (re.compile(r"\bgithub_pat_[A-Za-z0-9_]{30,}"), "[REDACTED-GITHUB-TOKEN]"),
    (re.compile(r"\bATATT[A-Za-z0-9_=-]{20,}"), "[REDACTED-ATLASSIAN-TOKEN]"),
    (re.compile(r"\bAIza[0-9A-Za-z_-]{30,}"), "[REDACTED-GOOGLE-KEY]"),
    (re.compile(r"\b[sr]k_(?:live|test)_[0-9A-Za-z]{16,}"), "[REDACTED-STRIPE-KEY]"),
    # sk-ant-…, sk-proj-…: a digit somewhere, so CSS classes like sk-folding-cube-container stay
    (re.compile(r"\bsk-[A-Za-z0-9_-]{20,}"), lambda m: "[REDACTED-API-KEY]" if re.search(r"\d", m.group(0)) else m.group(0)),
    (re.compile(r"\bglpat-[A-Za-z0-9_-]{20,}"), "[REDACTED-GITLAB-TOKEN]"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----(?:(?:(?!-----BEGIN )[\s\S]){0,20000}?-----END [A-Z ]*PRIVATE KEY-----|(?:\s*[A-Za-z0-9+/=]{16,})*)"),
     "[REDACTED-PRIVATE-KEY]"),
    # a token, not a word: "Bearer acknowledgements" in prose stays
    (re.compile(r"(?i)\b(bearer)(\s+)(?!\[REDACTED)(?=[A-Za-z0-9\-._~+/]*[0-9._~+/-])[A-Za-z0-9\-._~+/]{16,}=*"),
     r"\1\2[REDACTED]"),
    (re.compile(r"(?i)\b(bearer\s+\$\{\s*[\"'])(?!\[REDACTED)[^\"'\n]{8,}(?=[\"'])"), r"\1[REDACTED]"),  # `Bearer ${'tok'}`
    (re.compile(r"(?i)\b([a-z][a-z0-9+.-]{0,30}://)[^/\s:@\"'`]*:[^/\s@\"'`]+@"), r"\1[REDACTED]@"),
    (re.compile(r"(?i)\b(jsessionid|phpsessid|asp\.net_sessionid|connect\.sid)=(?!\[REDACTED)[^;\s\"'`&]+"),
     r"\1=[REDACTED]"),
    # ?key=: only a key-looking value (a digit, 12+ chars); `?key=password` sorts a table
    (re.compile(r"(?i)([?&]key=)(?!\[REDACTED)(?=[^&\s\"'`#]*\d)[^&\s\"'`#]{12,}"), r"\1[REDACTED]"),
    (re.compile(r"(?i)(\b(?:sid|session)[\"']?\s*[:=]\s*[\"']?)(?!\[REDACTED|/)[A-Za-z0-9%._~+/-]{16,}"), r"\1[REDACTED]"),  # session-length only
    # not ?code=: usually an ordinary value (road/segment codes); an OAuth code is single-use and short-lived
    (re.compile(r"(?i)([?&](?:access_token|id_token|token|sig|signature|api_key|apikey|"
                r"x-amz-signature|x-amz-credential|x-amz-security-token|x-goog-signature|x-goog-credential)=)(?!\[REDACTED|<|\$\{|\{|:\w)"
                r"[^&\s\"'`#]+"), r"\1[REDACTED]"),
]
# one whitespace run unless a quote or backslash splits it: two adjacent runs made a long run of spaces quadratic
# (`**Password:** x`, `password: \`x\``: Markdown's bold marks and backticks sit around the separator)
_SEP = r"([ \t]*[*_]{0,3}(?:(?:\\[\"']?|[\"'])[ \t]*)?[:=][*_]{0,3}[ \t]*\\?[\"'`]?)"
HEADER_VALUE_RE = re.compile(rf"(?im)\b({SECRET_HEADERS})\b{_SEP}(?!\[REDACTED)"
                             rf"((?:(?!\b(?:{SECRET_HEADERS})\b[ \t]*[:=])[^\n\"'`\\}}])+)")
KEY_VALUE_RE = re.compile(rf"(?i)\b({SECRET_KEYS})\b{_SEP}(?!\[REDACTED|[=<>!~])([^\s\"'\\`]+)")  # not `token == null`
VALUE_END_RE = re.compile(r"[&;,](?=[\w.-]+=)|\}")  # where the value stops: `&next=`, `; Path=`, a closing `,` or `}`
# credentials on a command line or stated in a sentence ("the password is …"): redacted when the value looks like one
CLI_SECRET_RES = [
    re.compile(r"(?i)(\bcurl\b[^\n|;&]{0,300}?\s(?:-u|--user)[ =]*[\"']?[^\s:\"'/]+[\"']?:[\"']?)()(?!\[REDACTED|//)([^\s\"']+)"),
    re.compile(r"(?i)(\b(?:mysql|mysqldump|mariadb)\b[^\n|;&]{0,300}?\s-p)()(?!\[REDACTED)([^\s\"']+)"),
    re.compile(r"(?i)(\b(?:password|passwd|passcode|pwd))(\s+(?:is|was)\s+[\"']?)(?!\[REDACTED)([^\s\"'.,;]+)"),
]
HARMLESS = {"null", "none", "true", "false", "undefined", "required", "optional", "n/a", "na", "empty", "hidden"}


TYPE_WORD_RE = re.compile(r"(?i)(u?int|float|sha|hs|rs|es|uuidv?|utf-?|md|oauth|ipv|http|base|h)\d+")  # uuid4, HS256, int64
COOKIE_ATTRS = {"samesite", "httponly", "secure", "path", "domain", "maxage", "expires", "priority", "partitioned"}


def _tokenish(x):
    """A value that reads as a token: a long run of token characters, or letters and digits mixed (6+ chars)."""
    return bool(re.search(r"[A-Za-z0-9._~+/-]{16,}", x)) or (
        len(x) >= 6 and bool(re.search(r"\d", x)) and bool(re.search(r"[A-Za-z]", x)) and not TYPE_WORD_RE.fullmatch(x))


def _secret_looking(v):
    """Prose like 'consent banner covers Save' or 'min' stays; tokens, k=v cookies and digits-in-a-word go. Limits,
    comparisons, calls and type names are rules about the field, not its value: 'maxlength=64', '>=8', 'min(8)', 'uuid4'."""
    v = v.strip()
    if not v or v.lower().strip(".,:;") in HARMLESS or v.startswith(("process.", "${", "env.", "<", "[REDACTED", "=", ">", "!", "~")):
        return False
    if re.fullmatch(r"v?\d+(\.\d+){1,3}[.,;]?", v):  # a version (token=1.42.0 in a changelog), not a secret
        return False
    # a limit or a CSS pseudo-class, not a value: 'Password: 8-64 characters', 'token: 30min', 'input#password:nth-child(2)'
    if re.fullmatch(r"\d+([-–.,:/]\d+)*[A-Za-z%]{0,5}[.,;]?|[@\w.-]+\(.*", v) or TYPE_WORD_RE.fullmatch(v.strip(".,;")):
        return False
    if re.fullmatch(r"[A-Za-z_]+(\.[A-Za-z_]+)+[,;]?", v):  # code: this.form.value.password, Validators.required (no digits)
        return False
    if "=" in v:  # k=v pairs: a secret when a value in them reads as a token ('sid=abc123def'), not 'max=64'
        return any(_tokenish(x.partition("=")[2] or x) for x in re.split(r"[;&]", v) if x.partition("=")[0].lower().replace("-", "") not in COOKIE_ATTRS)
    if re.search(r"[A-Za-z0-9._~+/-]{16,}", v):
        return True
    return " " not in v and bool(re.search(r"\d", v)) and len(v) >= 4 and (_tokenish(v) or not v.isalnum())


BASIC_RE = re.compile(r"(?i)\b(basic)(\s+)(?!\[REDACTED)([A-Za-z0-9+/]{6,}={0,2})(?![A-Za-z0-9+/=])")


def redact_literals(text):
    for pattern, repl in LITERAL_REDACTIONS:
        text = pattern.sub(repl, text)
    # 'Basic <base64 of user:password>' outside a header line ("auth": "Basic dXNlcjpwYXNz", prose, a spec)
    return BASIC_RE.sub(lambda m: m.group(1) + m.group(2) + "[REDACTED]" if _basic_credentials(m.group(3))
                        else m.group(0), text)


AUTH_SCHEME_RE = re.compile(r"(\s*(?:bearer|basic|token|digest|negotiate|ntlm|aws4-hmac-sha256)\s+)(\S+)", re.I)
COOKIE_PAIRS_RE = re.compile(r"\s*(?:[^\s;=]+=[^\s;]*;?\s*)+")


def _basic_credentials(tok):
    """Base64 of 'user:password' (it can be all letters, like dXNlcjpwYXNz)."""
    import base64
    import binascii
    try:
        return ":" in base64.b64decode(tok + "=" * (-len(tok) % 4), validate=True).decode("utf-8")
    except (binascii.Error, UnicodeDecodeError, ValueError):
        return False


def _header_value(val, name=""):
    """Redact only the credential in a header line's value, so prose after it survives:
    'Bearer <tok>' -> the token; 'a=1; sid=x' -> the pairs; otherwise a secret-looking first word."""
    m = AUTH_SCHEME_RE.match(val)
    other = None if m or "authorization" not in name.lower() else re.match(r"(\s*[A-Za-z][\w-]{1,20}\s+)(\S+)", val)
    if m or other:  # `Authorization: ApiKey <tok>`, `SSWS <tok>`: any scheme, when the word after it reads as a token
        m = m or other
        tok = m.group(2).rstrip("),.;")
        trail = m.group(2)[len(tok):]
        prose = tok.isalpha() and tok.islower() and re.match(r"\s+[A-Za-z]", val[m.end():])  # 'Bearer expected but missing'
        if tok.startswith(("process.", "${", "$", "env.", "<", "{{", "{")):  # `Bearer ${accessToken}`, `Bearer {{authToken}}`, `Bearer <access-token>`, `Bearer $TOKEN`
            return val
        secret = _secret_looking(tok) or _basic_credentials(tok) or (
            not other and not prose and len(tok) >= 8 and tok.lower().strip(".,:;") not in HARMLESS)
        return m.group(1) + ("[REDACTED]" if secret else tok) + trail + val[m.end():]
    m = COOKIE_PAIRS_RE.match(val)
    if m and "=" in m.group(0) and not all(x.split("=")[0].strip(" ,").lower().replace("-", "") in COOKIE_ATTRS
                                           for x in re.split(r"[;\s]+", m.group(0).strip()) if x):  # not 'SameSite=Lax missing'
        tail = m.group(0)[len(m.group(0).rstrip(" ,")):]  # the ", " or space before whatever follows (a next header)
        return " " * (m.group(0)[:1] == " ") + "[REDACTED]" + (tail or (" " if val[m.end():] else "")) + val[m.end():]
    first = (val.split() or [""])[0]
    # an x-api-key / x-auth-token value is the key itself, letters only or not
    prose = (first.isalpha() and len(val.split()) > 1) or bool(  # 'X-Api-Key: mandatory for /api/zones', 'Mismatch error shown'
        re.match(r"[A-Za-z_]\w*([.\[(]|$)", first) and re.search(r"[.\[(]", first))  # code: environment.apiKey, req.headers['x']
    if first and (_secret_looking(first) or (name.lower().startswith("x-") and len(first) >= 8 and not prose
                                             and first.lower().strip(".,:;") not in HARMLESS
                                             and not first.startswith(("process.", "${", "$", "env.", "<", "{{", "{")))):
        return val.replace(first, "[REDACTED]", 1)
    return val


QUOTED_SECRET_RE = re.compile(rf"(?i)\b({SECRET_KEYS})\b([ \t]*(?:[\"'][ \t]*)?[:=][ \t]*)([\"'])(?!\[REDACTED)([^\"'\n]{{4,}})\3")


# a quoted sentence after a secret name is the app's message ("Password is too short"), not a passphrase ("correct horse battery")
MESSAGE_WORD_RE = re.compile(r"(?i)\b(is|are|was|has|have|must|be|or|not|the|too|at|to|required|invalid|expired|missing|cannot|"
                             r"can't|should|does|did|field|wrong|incorrect|failed|match|least|most|your|enter|please|short|long|weak)\b")


def _quoted_secret(m):
    """`password: 'letmein'`, `"apiKey": "correct horse"`: a quoted literal after a secret name is the secret itself."""
    v = m.group(4)
    keep = v.strip().lower() in HARMLESS or v.startswith(("process.", "${", "env.", "<", "{{", "%")) or bool(
        re.search(r"\||^(required|nullable|string|min|max|pattern)\b", v)) or (  # a validation rule: 'required|min:8|max:64'
        len(v.split()) >= 2 and not re.search(r"[A-Za-z0-9._~+/-]{16,}", v) and bool(
            MESSAGE_WORD_RE.search(v) or v[:1].isupper())) or bool(  # a sentence: "Minimum 8 characters", "Bad credentials"
        re.match(r"\s*[).,\]]", v))  # getByLabel('Password:').fill('x'): the text between two other strings
    return m.group(0) if keep else f"{m.group(1)}{m.group(2)}{m.group(3)}[REDACTED]{m.group(3)}"


def _assigned_secret(v):
    """The value in `password=<v>`: an assignment's value is the secret whatever its characters (Sommerregen), unless
    it is a word like `required`, a limit, a placeholder or code (`getPassword()`, `await`, `this.x`)."""
    v = v.strip()
    return _secret_looking(v) or (
        len(v) >= 3 and v.lower().strip(".,:;") not in HARMLESS | {"await", "new", "true", "false", "nil", "this", "self"}
        and not v.startswith(("process.", "${", "$", "env.", "<", "[", "{", "(", "this.", "self.", "/", ":"))
        and not re.fullmatch(r"v?\d+([-–.,:/]\d+)*[A-Za-z%]{0,5}[.,;]?|[@\w.]+\(.*|[a-z_][A-Za-z_]*(\.[A-Za-z_]+)+[,;]?", v))  # user.password


TABLE_ROW_RE = re.compile(rf"(?im)(\|[ \t]*`?(?:{SECRET_HEADERS}|{SECRET_KEYS})`?[ \t]*\|[ \t]*`?)(?!\[REDACTED)([^|\n`]+?)(`?[ \t]*\|)")


def redact(text):
    """Prose and log text: literal tokens plus secret-looking values of secret-named headers and keys."""
    def sub(m):  # `password=Tr0ub4dor&3` is one value; `password=x&user=qa` and `password: x,` end at the mark
        if m.group(2)[-1:] in "\"'`" and m.string[m.end():m.end() + 1] == " ":
            return m.group(0)  # the first word of a quoted sentence: QUOTED_SECRET_RE has judged the whole of it
        core = m.group(3).rstrip("&;,.})")  # closing punctuation is not part of the value
        end = VALUE_END_RE.search(core)
        v = core[:end.start()] if end else core
        rest = m.group(3)[len(v):]
        if re.search(r"[\^\[\]|*]", v):  # a pattern or a rule about the field: `pattern=^[A-Z]{8,64}$`, `required|min:8`
            return m.group(0)
        secret = (_assigned_secret if "=" in m.group(2) else _secret_looking)(v)
        return m.group(1) + m.group(2) + ("[REDACTED]" if secret else v) + rest
    for _ in range(5):  # a value ends early now, so a second header on the same line needs another pass
        before = text
        text = redact_literals(text)
        text = QUOTED_SECRET_RE.sub(_quoted_secret, text)
        text = HEADER_VALUE_RE.sub(lambda m: m.group(1) + m.group(2) + _header_value(m.group(3), m.group(1)), text)
        text = KEY_VALUE_RE.sub(sub, text)
        text = TABLE_ROW_RE.sub(lambda m: m.group(1) + ("[REDACTED]" if (_secret_looking if " " in m.group(2).strip()
                                                                          else _assigned_secret)(m.group(2)) else m.group(2))
                                + m.group(3), text)  # `| api_key | 4f3c… |`
        for pattern in CLI_SECRET_RES:
            text = pattern.sub(lambda m: m.group(1) + m.group(2) + ("[REDACTED]" if pattern is not CLI_SECRET_RES[2]
                                                                    or _secret_looking(m.group(3)) else m.group(3)), text)
        if text == before:
            break
    return text


def redact_json(obj):
    """Structured: values of secret-named keys (and HAR-style {name, value} headers) become "[REDACTED]"."""
    if isinstance(obj, dict):
        label = obj.get("name") if isinstance(obj.get("name"), str) else obj.get("key")  # {name|key: …, value: …}
        named = isinstance(label, str) and "value" in obj and (SECRET_NAME_RE.match(label) or (
            label.lower() == "sid" and len(str(obj["value"])) >= 16))  # sid: session cookie vs site id
        out = {}
        for k, v in obj.items():
            if isinstance(k, str) and k.lower() == "cookies" and isinstance(v, (list, dict)):  # a cookie jar: every value
                hide = lambda x: "[REDACTED]" if x not in (None, True, False, "") else x
                out[k] = {n: hide(x) for n, x in v.items()} if isinstance(v, dict) else [
                    {**c, "value": hide(c["value"])} if isinstance(c, dict) and "value" in c else redact_json(c) for c in v]
                continue
            secret = (isinstance(k, str) and (SECRET_NAME_RE.match(k) or (k.lower() == "sid" and len(str(v)) >= 16))
                      or (named and k == "value"))
            out[k] = "[REDACTED]" if secret and v not in (None, True, False, "") else redact_json(v)
        return out
    if isinstance(obj, list):
        if len(obj) == 2 and isinstance(obj[0], str) and isinstance(obj[1], str) and obj[1] and SECRET_NAME_RE.match(obj[0]):
            return [obj[0], "[REDACTED]"]  # a header as a [name, value] pair
        return [redact_json(v) for v in obj]
    return redact(obj) if isinstance(obj, str) else obj


PROSE_SUFFIXES = {".md", ".txt", ".log", ".html", ".htm", ".yml", ".yaml", ".csv"}
JSON_SUFFIXES = {".json", ".har"}
CODE_SUFFIXES = {".ts", ".js", ".mjs", ".cjs", ".py"}


def scrub_file(f):
    try:
        before = f.stat()
        text = f.read_text()
    except (OSError, UnicodeDecodeError):
        return
    same = lambda a: (a.st_ino, a.st_size, a.st_mtime_ns) == (before.st_ino, before.st_size, before.st_mtime_ns)
    if f.suffix in JSON_SUFFIXES:
        try:
            obj = json.loads(text)
        except (ValueError, RecursionError):
            return  # leave unparseable JSON as is rather than corrupt it (ingest parks it with a message)
        clean_obj = redact_json(obj)
        clean = text if clean_obj == obj else json.dumps(clean_obj, indent=2, ensure_ascii=False) + "\n"
    elif f.suffix in CODE_SUFFIXES:
        clean = redact_literals(text)  # repro specs must stay runnable
    else:
        clean = redact(text)
    if clean != text:
        st = f.stat()
        # write + rename: a hook killed mid-write can't leave a truncated draft; a fresh temp file (O_EXCL), so a
        # planted .<name>.scrub link can't redirect the write outside qa-out
        fd, tmp = tempfile.mkstemp(dir=f.parent, prefix=f".{f.name}.", suffix=".scrub")
        try:
            with os.fdopen(fd, "w") as fh:
                fh.write(clean)
            os.chmod(tmp, st.st_mode & 0o7777)
            os.utime(tmp, (st.st_atime, st.st_mtime))  # keep the run's finish time for late-ingest ordering
            if not same(f.stat()):  # an explorer rewrote it meanwhile: keep its write, the next hook scrubs that
                Path(tmp).unlink()
                return
            os.replace(tmp, f)
        except BaseException:
            Path(tmp).unlink(missing_ok=True)
            raise


def scrub_tree(root, budget=4.0):
    """Scrub text files under qa-out changed since the last scrub (also folders without a run.json), oldest first,
    for at most `budget` seconds per call: a large backlog (an upgrade, weeks of runs) must not push the Stop hook
    past its timeout, which would leave the stamp unwritten and stall every turn. The stamp is the start time of the
    last complete pass, or "<mtime> <path>" of the last file done when a pass stopped early (an exact cursor: a copied
    qa-out has thousands of files with one mtime)."""
    stamp = root / ".scrubbed"
    try:
        since, _, cursor = stamp.read_text().partition(" ")
        since = float(since)
    except (OSError, ValueError):
        since, cursor = 0.0, ""
    started = time.time()
    todo = []
    for f in root.rglob("*"):
        try:
            if f.is_file() and not f.is_symlink() and f.suffix in PROSE_SUFFIXES | JSON_SUFFIXES | CODE_SUFFIXES:
                st = f.stat()
                # ctime too: a draft copied in with its old mtime (cp -a, a restored backup) is new here
                key = (max(st.st_mtime, st.st_ctime), str(f))
                if (key > (since, cursor) if cursor else key[0] >= since - 2) and st.st_size < 20_000_000:
                    todo.append(key)
        except OSError:
            continue
    todo.sort()
    done = None
    for mtime, name in todo:
        if done is not None and time.time() - started > budget:
            break
        try:
            scrub_file(Path(name))
        except (OSError, RecursionError):  # one odd file (nested past the stack) must not stop every ingest
            pass
        done = (mtime, name)
    else:
        done = None  # the whole backlog: the next pass starts from this one's start time
    try:
        stamp.write_text(f"{done[0]} {done[1]}" if done else str(started))
    except OSError:
        pass


def _first_line(p):
    try:
        return p.read_text().split("\n", 1)[0]
    except OSError:
        return None


def _pending(root):
    """[(file, bytes, mtime, sha1)] for run.json and code-map-*.json whose content changed since its last
    ingest, oldest first. Sentinels hold the sha1 of the file they cover, so clock skew or copied mtimes can't
    cause loops."""
    out = []
    for f in [*root.rglob("run.json"), *root.glob("*/.data/run-*.json"),  # old layout, then run folders
              *(root / "init").glob("code-map-*.json")]:  # code maps: qa-out/init only
        try:
            data, mtime = f.read_bytes(), f.stat().st_mtime
        except OSError:
            continue
        digest = hashlib.sha1(data).hexdigest()
        if digest not in (_first_line(f.with_name(f.name + ".ingested")), _first_line(f.with_name(f.name + ".error"))):
            out.append((f, data, mtime, digest))
    return sorted(out, key=lambda x: x[2])


PARKED = []  # run.json / code-map files this process could not ingest (shown to the agent by the hook)


def _ingest_files(con, pending):
    n = 0
    for f, data, mtime, digest in pending:
        done, err = f.with_name(f.name + ".ingested"), f.with_name(f.name + ".error")
        # When the run finished; never in the future (a skewed mtime would freeze the current build).
        ts = datetime.fromtimestamp(min(mtime, time.time()), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        try:
            note = ""
            if f.name.startswith("code-map-"):
                dropped = ingest_codemap(con, redact_json(json.loads(data)), f, ts)
                note = f"dropped rows: {dropped}\n" if dropped else ""
            else:
                ingest(con, redact_json(json.loads(data)), ts, f.parent, f.resolve())  # also files the mtime-based scrub skipped
            done.write_text(f"{digest}\n{now()}\n{note}")
            err.unlink(missing_ok=True)
            n += 1
        except sqlite3.OperationalError as e:  # transient (e.g. DB locked): retry on the next hook run
            print(f"qa-mem: will retry {f}: {e}", file=sys.stderr)
        except Exception as e:  # noqa: BLE001 - bad file: park it until it is rewritten
            err.write_text(f"{digest}\n{now()} {type(e).__name__}: {e}\n")
            print(f"qa-mem: skipped {f}: {e}", file=sys.stderr)
            PARKED.append(f"{f}: {type(e).__name__}: {e}")
    return n


# ---------- code map: routes, locators, rules and endpoints read from the app's source ----------
CODEMAP_AREAS = ("frontend", "backend", "tests")  # one qa-mapper agent per area
CODEMAP_KINDS = ("route", "locator", "rule", "api")
CODEMAP_PAGE_CAP = 200  # per page; page '*' (the whole backend) is exempt
SCAN_SKIP_DIRS = {"node_modules", ".git", "dist", "build", "out", ".next", ".nuxt", ".svelte-kit", ".angular", "coverage",
                  "vendor", "__pycache__", ".venv", "venv", "target", "bin", "obj", ".cache", ".turbo", "storybook-static",
                  "qa-out", ".playwright-cli", ".playwright-mcp", ".idea", ".vscode"}
FRONTEND_SUFFIXES = {".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".vue", ".svelte", ".html"}
TEMPLATE_SUFFIXES = {".cshtml", ".razor", ".erb", ".jsp", ".twig", ".hbs", ".njk"}  # server-rendered UI (.blade.php: name)
BACKEND_SUFFIXES = {".py", ".java", ".kt", ".cs", ".go", ".rb", ".php"}
SPEC_SUFFIXES = {".yaml", ".yml", ".json"}
# Never read: secret stores and keys (source files are judged on content; literal secrets are scrubbed at ingest).
SECRET_FILE_RE = re.compile(r"(?i)^\.env|\.(pem|key|p12|pfx|jks|keystore|crt|cer|kdbx)$|^secrets?\.(json|ya?ml|env|"
                            r"properties|ini|toml|txt|xml)$|^credentials?\.(json|xml|ya?ml|ini|toml|txt)$|"
                            r"^id_(rsa|ed25519|ecdsa|dsa)|^\.(npmrc|netrc|pgpass|pypirc|dockercfg)$|^appsettings\.\w+\.json$|"
                            r"^secrets?\.(py|rb|php|go|java|kt|cs)$|^credentials?\.(py|rb|php|go)$|^wp-config\.php$")
GENERATED_FILE_RE = re.compile(r"(?i)\.min\.(js|css)$|\.map$|^(package-lock\.json|yarn\.lock|pnpm-lock\.yaml|"
                               r"composer\.lock|Gemfile\.lock|poetry\.lock|Cargo\.lock)$|\.(bundle|chunk)\.js$|\.d\.ts$|"
                               r"\.generated\.|\.g\.(ts|cs)$")
TEST_WORDS = {"test", "tests", "spec", "specs", "cypress", "playwright", "selenium", "pageobject", "pageobjects", "pom"}
TEST_NAME_RE = re.compile(r"(?i)\.(spec|test|cy|e2e|po)\.\w+$")
UNIT_TEST_RE = re.compile(r"(?i)\.(spec|test)\.\w+$|(^|/)test_\w+\.py$|\b(describe|it|test)\(\s*['\"`]|import\s+pytest|"
                          r"@Test\b|\[Fact\]|\[Test\]")
TESTS_RE = re.compile(r"get_by_(test_id|role|label|text|placeholder|alt_text|title)\(|GetBy(TestId|Role|Label|Text|Placeholder|"
                      r"AltText|Title)\(|\.Locator\(|By\.(ID|CSS_SELECTOR|XPATH|NAME|CLASS_NAME|LINK_TEXT)\b|"
                      r"By\.(Id|CssSelector|XPath|Name|ClassName|LinkText)\(|\[FindsBy|"
                      r"getBy(TestId|Role|Label|Text|Placeholder|AltText|Title)\(|page\.(locator|fill|click|check|type|"
                      r"selectOption)\(|\.locator\(|cy\.(get|findBy\w+|contains)\(|By\.(id|css|cssSelector|xpath|name|"
                      r"className|linkText|tagName)\(|@FindBy\(|\$\$?\(['\"`]|data-testid|data-test|data-cy")
TESTS_IMPORT_RE = re.compile(r"""from\s+['"]@playwright/test['"]|require\(\s*['"]@playwright/test|from\s+['"]cypress|"""
                             r"""\bcy\.(visit|get)\(|^from\s+selenium|^import\s+org\.openqa\.selenium|webdriverio|"""
                             r"""from\s+['"]@testing-library|\bbrowser\.\$\(|^from\s+playwright\.(sync_api|async_api)|"""
                             r"""^using\s+(Microsoft\.Playwright|OpenQA\.Selenium)|^import\s+com\.microsoft\.playwright|"""
                             r"""^(from|import)\s+behave\b|pytest_bdd""", re.M)
PO_CLASS_RE = re.compile(r"\bclass\s+\w*(Page|Screen|Po|PO)(Object)?\b")
PO_CALL_RE = re.compile(r"\bpage\.getBy\w+\(|\.locator\(|\bGetBy(Role|TestId|Label|Text|Placeholder|AltText|Title)\(|"
                        r"\.Locator\(|FindElement\(By\.|@FindBy\(|\bget_by_(role|test_id|label|text|placeholder|alt_text|"
                        r"title)\(|\bcy\.get\(")  # not repository calls (GetByIdAsync, get_by_email)
BACKEND_RE = re.compile(
    r"@(Get|Post|Put|Patch|Delete|RequestMapping|GetMapping|PostMapping|PutMapping|DeleteMapping|PatchMapping|Controller|"
    r"RestController|Path|GET|POST|PUT|DELETE|PATCH)\b|"                      # Spring, Nest, JAX-RS
    r"\b(router|app|server|fastify|v1|api_router|blueprint)\.(get|post|put|patch|delete|route)\(\s*['\"`]/|"  # express-ish
    r"express\.Router\(|from\s+['\"](express|fastify|koa|@nestjs/\w+|hapi)['\"]|require\(\s*['\"](express|fastify|koa)['\"]|"
    r"\[Http(Get|Post|Put|Patch|Delete)|\[Route\(|\.Map(Get|Post|Put|Patch|Delete)\(|"           # ASP.NET
    r"\[(Required|StringLength|MaxLength|MinLength|Range|RegularExpression|EmailAddress)\b|AbstractValidator<|RuleFor\(|"
    r"@\w+\.(get|post|put|patch|delete|route)\(|\burlpatterns\b|viewsets\.|APIView\b|generics\.\w+View|"  # Flask, FastAPI, Django
    r"\.(GET|POST|PUT|PATCH|DELETE|Handle|HandleFunc|Get|Post|Put|Patch|Delete|Route|Group|Mount)\(\s*\"|"  # Go routers
    r"\b(validate|binding):\"|@(field:|get:|param:)\w+|\[property:\s*\w+|@api_view\(|\bserializers\.\w+(Field|Serializer)\b|"
    r"\bforms\.\w+Field\(|from\s+['\"]hono['\"]|"
    r"@(Min|Max|Size|NotNull|NotBlank|NotEmpty|Length|Pattern|Range|Positive|Email|Valid)\b|"
    r"@(Is\w+|MaxLength|MinLength|Matches)\(|\bField\([^)]*\b(ge|le|max_length)=|"
    r"Rails\.application\.routes|\bresources\s+:|\bvalidates\s+:|params\.require\(|"                 # Rails
    r"Route::(get|post|put|patch|delete|resource|apiResource)\(|extends\s+FormRequest|->validate\(\[|"    # Laravel
    r"\bmodels\.\w+Field\(|forms\.ModelForm|\bmarshmallow\b|\brouting\s*\{|"                          # Django, Ktor
    r"\b(body|query|param|check)\(\s*['\"][\w.]+['\"]\s*\)\s*\.(is\w+|not\w*|matches|exists)")
FRONTEND_RE = re.compile(r"\bpath\s*:\s*['\"`]|<Route\b|createBrowserRouter|createHashRouter|RouterModule|\bRoutes\b|"
                         r"createRouter\(|vue-router|data-testid|data-test=|data-cy|aria-label|formControlName|"
                         r"Validators\.|\bv-model|\bng-model|\byup\.|\bz\.(object|string|number)|useForm\(|register\(|"
                         r"\b(required|maxLength|minLength|pattern)\b|\b(min|max)=|\bfetch\(|\baxios\b|HttpClient|\$http|"
                         r"\buseQuery\(|\bapiClient\b|['\"`]/api/|<template\b|@Component\(|export\s+default\s+defineComponent|"
                         r"\b\w*(api|http|client|request)\w*\.(get|post|put|patch|delete)\s*(<[^()]*?>)?\s*\(")  # api.post<Z>('/zones')
PAGE_DIR_RE = re.compile(r"(^|/)(app|pages|routes|views|screens)/")  # file-system routing (Next, Nuxt, SvelteKit, Remix)
UI_SIGNAL_RE = re.compile(r"export\s+((async\s+)?function|const|let)\s+(load|loader|action|generateMetadata|"
                          r"getServerSideProps|getStaticProps)\b|['\"]use client['\"]|@Component\(|defineComponent|<template\b")
UI_TAG_RE = re.compile(r"<[A-Za-z][\w.-]*[\s/>]")  # a tag; in .ts it would be a generic (Promise<Zone>)
NOISE_FILE_RE = re.compile(r"(?i)\.(stories|story|fixtures?|mocks?)\.\w+$|(^|/)(__mocks__|mocks|__fixtures__|test-utils|"
                           r"testing)/|(^|/)setupTests\.\w+$")
BACKEND_WEAK_RE = re.compile(r"\b(openapi|swagger)\b|\bJoi\.|\bcelebrate\(|\bpydantic\b")  # backend languages only
SERVER_SIGNAL_RE = re.compile(r"\bmongoose\.(Schema|model)\b|new\s+Schema\(|sequelize\.define|\bDataTypes\.|@(Column|Entity|"
                              r"PrimaryGeneratedColumn)\b|@prisma/client|\bknex\.schema|\(\s*req\s*,\s*res\b|\breq\.(body|params|query)\b|"
                              r"module\.exports\s*=\s*\{?\s*\w*(Controller|Service|Model|Repository)")
SCHEMA_RE = re.compile(r"from\s+['\"](zod|yup|joi|class-validator|valibot|superstruct)['\"]|\bz\.object\(|\byup\.object\(|"
                       r"\bJoi\.object\(|\bmarshmallow\b|validate:\"")
PAGE_SIGNAL_RE = re.compile(r"\.goto\(|GotoAsync\(|GoToUrl\(|cy\.visit\(|\bnavigate(To)?\(|driver\.get\(|browser\.url\(|"
                            r"\bclass\s+\w*(Page|Screen|Po|PO|Component|Dialog|Modal|Form|Panel|Section|Widget)(Object)?\b|"
                            r"(?i:(^|/)(pages|pom|po|steps?|page-?objects?|e2e|cypress|playwright)/)")
SPEC_VERSION_RE = re.compile(r"(?m)^\s*['\"]?(openapi|swagger)['\"]?\s*:\s*['\"]?\d|[{,]\s*\"(openapi|swagger)\"\s*:\s*\"\d")
CONFIG_FILE_RE = re.compile(r"(?i)(^|/)(application|bootstrap)[\w.-]*\.(ya?ml|properties)$|(^|/)docker-compose[\w.-]*\.ya?ml$|"
                            r"(^|/)values[\w.-]*\.ya?ml$|"
                            r"\.tfvars$|(^|/)config\.(json|ya?ml)$|(^|/)(next|nuxt|vite|vue|svelte|astro|remix|webpack)\.config\.\w+$|"
                            r"(^|/)environments?/environment[\w.-]*\.ts$|(^|/)(config|configuration|settings|secrets?|"
                            r"credentials?)\.(js|ts|mjs|cjs)$|(^|/)config/(default|production|development|staging|local|test|"
                            r"custom-environment-variables)[\w.-]*\.(js|ts|mjs|cjs)$")
SECRET_CONTENT_RE = re.compile(r"(?m)^\s*(SECRET_KEY|INSTALLED_APPS|DATABASES)\s*=|class\s+\w+\(\s*BaseSettings\s*\)|"
                               r"-----BEGIN [A-Z ]*PRIVATE KEY-----|\b[a-z][\w+.-]*://[^\s:/'\"@]+:[^\s@'\"/]+@")
# Django settings, pydantic settings, keys, connection URIs with a password (mongodb://user:pass@host)
CONFIG_SECRET_RE = re.compile(r"(?i)\b(secret\w*|pass(word|wd|phrase)?|pwd|private_?key\w*|api_?key\w*|\w*token)['\"]?\s*[:=]\s*"
                              r"['\"][^'\"\s]{6,}['\"]")  # in a config/ folder: a literal credential
SERVER_ROUTE_PATH_RE = re.compile(r"(^|/)(pages/api/|app/(.*/)?route\.(ts|js)$|[^/]*\+server\.(ts|js)$|server/(api|routes|"
                                  r"middleware)/)")
SERVER_ROUTE_RE = re.compile(r"export\s+(async\s+)?(function|const)\s+(GET|POST|PUT|PATCH|DELETE)\b|defineEventHandler\(|"
                             r"NextApiRequest|\(\s*req\b[^,)]*,\s*res\b")
JSX_RE = re.compile(r"<[A-Z][\w.]*[\s/>]|return\s*\(?\s*<(div|form|input|button|table|section|main|ul|span|a)[\s>]")
STRONG_UI_RE = re.compile(r"<[A-Z][\w.]*[\s/>]|<(div|form|input|button|table|select|textarea)\b|<template\b|@Component\(|"
                          r"['\"]use client['\"]")
STRONG_UI_TS_RE = re.compile(r"<template\b|@Component\(|['\"]use client['\"]")  # .ts can't hold JSX: <Zone> is a generic
ROUTER_ENTRY_RE = re.compile(r"\bpath\s*:\s*['\"`]|<Route\b")  # two or more in a file: it is a router
PKG_CONTAINERS = {"packages", "apps", "services", "libs", "modules", "projects"}
SCAN_MAX_BYTES = 400_000  # bigger files are generated or data, not hand-written source
COMMIT_RE = re.compile(r"[0-9a-f]{40}([0-9a-f]{24})?")


GIT_SLOW = []


def _git(repo, *args, timeout=30):
    """git output (text) or None. Paths stay unquoted (core.quotePath=false) so non-ASCII names round-trip."""
    try:
        r = subprocess.run(["git", "-c", "core.quotePath=false", "-C", str(repo), *args], capture_output=True,
                           encoding="utf-8", errors="surrogateescape", timeout=timeout)  # a file name may not be UTF-8
    except subprocess.TimeoutExpired:
        GIT_SLOW.append(repo)  # the card stops asking (one hung git is usually all of them: a network share)
        return None
    except OSError:
        return None
    return r.stdout if r.returncode == 0 else None


def _rel_files(root):
    """Relative paths of regular files under root. In a git repo: tracked and untracked-but-not-ignored files, the
    same set incremental scans see (so ignored generated code is never mapped); otherwise a walk of the tree."""
    listed = _git(root, "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", ".")
    rels = [rel.rstrip("/") for rel in (listed or "").split("\0") if rel and os.path.normpath(rel) != "."]
    if rels:  # (nothing listed: not a repo, or a folder a parent repo ignores: walk it)
        for rel in rels:
            if os.path.isdir(os.path.join(root, rel)) and not os.path.islink(os.path.join(root, rel)):
                # (an empty, uninitialised submodule lists nothing of its own: git answers for the parent there)
                if not any(part in SCAN_SKIP_DIRS for part in rel.split("/")) and os.path.exists(os.path.join(root, rel, ".git")):
                    yield from (f"{rel}/{sub}" for sub in _rel_files(os.path.join(root, rel)))  # a submodule: its own files
            elif rel.isprintable() and rel.encode("utf-8", "ignore").decode() == rel \
                    and not any(part in SCAN_SKIP_DIRS for part in rel.split("/")[:-1]):  # (a name the DB can't hold: skipped)
                yield rel
        return
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in SCAN_SKIP_DIRS and not d.startswith(".")]
        for name in files:
            yield os.path.relpath(os.path.join(dirpath, name), root).replace(os.sep, "/")


def _decode_source(data):
    """Source text: UTF-16/32 when a BOM says so (Visual Studio can save .cs that way), else UTF-8 (BOM dropped); bytes
    that don't decode are dropped (a Latin-1 file still classifies by its ASCII)."""
    for bom, enc in ((b"\xff\xfe\0\0", "utf-32"), (b"\0\0\xfe\xff", "utf-32"), (b"\xff\xfe", "utf-16"),
                     (b"\xfe\xff", "utf-16")):
        if data.startswith(bom):
            return data.decode(enc, "ignore")
    return data.decode("utf-8-sig", "ignore")


def _strong_backend(text):
    """A real server signal: a route, a server import, request validation; not just a word like 'swagger'."""
    return bool(BACKEND_RE.search(text) or SERVER_SIGNAL_RE.search(text))


def _tests_path(path):
    """A test folder or file name: a whole word of a path segment (e2e, ui-tests, UiTests, __tests__, page-objects,
    qa-automation), never letters inside a word (inspections, LatestIncidents, speedtest, signal-automation-ui)."""
    for seg in path.split("/"):
        words = {w.lower() for w in re.findall(r"[A-Z]?[a-z]+|[A-Z]+(?![a-z])", seg)}
        if "e2e" in seg.lower() or words & TEST_WORDS or {"page", "objects"} <= words or {"page", "object"} <= words \
                or "automation" in words and (words & {"qa", "ui"} or seg.lower() == "automation"):
            return True
    return False


def _ui_file(name):
    """A UI component file by type: .jsx/.tsx/.vue/.svelte, Angular .component.ts/.html."""
    return os.path.splitext(name)[1].lower() in (".jsx", ".tsx", ".vue", ".svelte") or \
        bool(re.search(r"\.component\.(ts|html)$", name))


def _strong_ui(rel, text):
    return bool((STRONG_UI_TS_RE if rel.endswith((".ts", ".mts", ".cts")) else STRONG_UI_RE).search(text))


def _pkg(rel):
    """The top folder a file belongs to ('' at the root; packages/<x> in a monorepo)."""
    parts = rel.split("/")[:-1]
    return "/".join(parts[:2] if parts and parts[0] in PKG_CONTAINERS else parts[:1])


def classify_source(rel, text, folder=""):
    """The code-map area a source file feeds, or None. folder = the scanned folder's own name (a folder given as
    `e2e/` still counts as tests). Tests are page objects and specs with locators; backend needs a server-side
    signal (and backend languages never go to the frontend); frontend components are taken by file type."""
    name = rel.rsplit("/", 1)[-1]
    if SECRET_FILE_RE.search(name) or GENERATED_FILE_RE.search(name) or CONFIG_FILE_RE.search(rel) \
            or SECRET_CONTENT_RE.search(text[:20000]):
        return None  # secret stores, generated code, config that holds credentials
    suffix = os.path.splitext(name)[1].lower()
    if suffix in SPEC_SUFFIXES:  # only real API specs among data files (a version key), never config that holds secrets
        return "backend" if SPEC_VERSION_RE.search(text[:4000]) else None
    if suffix in TEMPLATE_SUFFIXES or name.endswith(".blade.php"):
        return "frontend"  # server-rendered pages: the UI lives in the template
    if suffix not in FRONTEND_SUFFIXES | BACKEND_SUFFIXES:
        return None
    if re.search(r"(^|/)config/", rel) and CONFIG_SECRET_RE.search(text):
        return None  # a config module holding credentials (config/index.js with a jwt secret)
    ui_file = _ui_file(name)
    # a component is a component wherever it sits (tests/, inspections/): only a test import or name makes it a test
    testish = TESTS_IMPORT_RE.search(text) or TEST_NAME_RE.search(name) or (not ui_file and _tests_path(f"{folder}/{rel}"))
    if testish and TESTS_RE.search(text) and PAGE_SIGNAL_RE.search(f"{folder}/{rel}\n{text}"):
        return "tests"  # e2e specs and page objects (they open pages); component unit tests don't
    if testish and (UNIT_TEST_RE.search(f"{folder}/{rel}") or UNIT_TEST_RE.search(text)):
        return None  # unit tests without locators teach nothing about pages
    if NOISE_FILE_RE.search(f"/{rel}"):
        return None  # stories, mocks, fixtures, test helpers: not what users see
    if SERVER_ROUTE_PATH_RE.search(f"/{rel}") and (SERVER_ROUTE_RE.search(text) or BACKEND_RE.search(text)):
        return "backend"  # API routes inside UI frameworks (Next pages/api and route.ts, SvelteKit +server, Nuxt server/)
    if ui_file:
        return "frontend"  # UI components, whatever words they contain
    if PO_CLASS_RE.search(text) and PO_CALL_RE.search(text) and not _strong_backend(text):
        return "tests"  # a page object outside a test folder (this.page.getBy…, FindElement(By.…))
    if _strong_backend(text) or (suffix in BACKEND_SUFFIXES and BACKEND_WEAK_RE.search(text)):
        return "backend"
    if suffix in BACKEND_SUFFIXES:
        return None  # server code with no routes or validation
    if (PAGE_DIR_RE.search(f"/{rel}") and suffix in (".ts", ".js")
            and (UI_SIGNAL_RE.search(text) or (suffix == ".js" and UI_TAG_RE.search(text)))) \
            or (suffix in (".js", ".mjs") and JSX_RE.search(text)):
        return "frontend"  # file-routed pages, and React components in .js files (no TS generics to confuse JSX)
    if FRONTEND_RE.search(text) or SCHEMA_RE.search(text):
        return "frontend"  # (a schema file beside server code is moved to backend by the scan)
    return None


CHUNK_FILES, CHUNK_TOKENS = 40, 60_000  # what one qa-mapper can read well; bigger areas are split across mappers


def _route_pages_by_file(con, repo):
    """{src: {pages}} for the files that define routes (frontend route rows)."""
    out = {}
    for src, page in con.execute("SELECT src, page FROM codemap WHERE repo=? AND kind='route' AND area='frontend' "
                                 "AND page!='*'", (repo,)):
        out.setdefault(src, set()).add(page)
    return out


def _route_pages(con):
    return {r[0] for r in con.execute("SELECT DISTINCT page FROM codemap WHERE kind='route' AND area='frontend' AND page!='*'")}


def codemap_scan(con, paths, out_dir, full=False, stamp=None, chunk_files=CHUNK_FILES, chunk_tokens=CHUNK_TOKENS):
    """List the source files each qa-mapper must read and write qa-out/init/scan-<area>[-<n>].json (one per mapper).
    Incremental by content: per area and repo, a file is listed when its content differs from what was last mapped
    (new, edited, uncommitted) or when an earlier scan listed it and its map never landed, or its rows were orphaned
    by a removed route. Files with
    rows that are gone or no longer this area's are listed as deleted. When a router (a file defining several routes)
    changed or a route file is gone, frontend and tests are mapped in full (rows elsewhere sit on routes that may have
    moved). Areas with nothing to read are settled here. Returns a summary dict for the skill."""
    stamp = stamp or datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    out_dir = Path(out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    for old in [*out_dir.glob("scan-*.json"), *out_dir.glob("code-map-*.json*")]:
        old.unlink(missing_ok=True)  # a new scan: maps of older scans are stale (and the Write tool won't overwrite them)
    summary = {"incremental": False, "total_files": 0, "tokens": 0, "areas": {}, "skipped": []}
    repos = []
    for raw in paths:
        repo = os.path.realpath(os.path.expanduser(str(raw)))
        if not os.path.isdir(repo):
            summary["skipped"].append(f"{raw}: not a folder")
            continue
        if os.path.dirname(repo) == repo or repo == os.path.realpath(os.path.expanduser("~")):
            # walking the whole disk or home folder takes minutes and maps unrelated code
            summary["skipped"].append(f"{raw}: too broad (the whole disk or home folder); give the app's repo folders")
            continue
        if any(r[0] == repo for r in repos):
            continue  # the same folder given twice (. and ./): listed once
        head = (_git(repo, "rev-parse", "HEAD") or "").strip()
        head = head if COMMIT_RE.fullmatch(head) else ""
        candidates = {}  # rel -> [area, bytes, text]
        for rel in _rel_files(repo):
            full_path = os.path.join(repo, rel)
            try:
                if os.path.islink(full_path) or not os.path.isfile(full_path) \
                        or not os.path.realpath(full_path).startswith(repo.rstrip(os.sep) + os.sep):
                    continue  # links (also a linked parent folder) can point out of the repo or at /dev/zero; FIFOs hang
                size = os.path.getsize(full_path)
                if size > SCAN_MAX_BYTES:
                    continue
                with open(full_path, "rb") as fh:
                    raw_bytes = fh.read()
            except OSError:
                continue
            text = _decode_source(raw_bytes)
            area = classify_source(rel, text, os.path.basename(repo))
            if area:
                candidates[rel] = [area, size, text, hashlib.sha1(raw_bytes).hexdigest()]
        # a server folder (a real route or server import, not a stray word): its schema files are request rules
        # (in a repo with UI components too, only schemas in the server's own top folder: client/ form schemas stay)
        be_pkgs = {_pkg(rel) for rel, c in candidates.items() if c[0] == "backend" and _strong_backend(c[2])}
        if be_pkgs:
            ui_pkgs = {_pkg(rel) for rel, c in candidates.items() if c[0] == "frontend" and _ui_file(rel.rsplit("/", 1)[-1])}
            for rel, c in candidates.items():
                if c[0] == "frontend" and SCHEMA_RE.search(c[2]) and not _strong_ui(rel, c[2]) \
                        and (not ui_pkgs or (_pkg(rel) in be_pkgs and _pkg(rel) not in ui_pkgs)):
                    c[0] = "backend"
        # hashed by bytes: an edit to a non-UTF-8 character is still an edit
        routers = {rel for rel, c in candidates.items() if c[0] == "frontend" and len(ROUTER_ENTRY_RE.findall(c[2])) > 1}
        repos.append((repo, head, {rel: (c[0], c[1], c[3]) for rel, c in candidates.items()}, routers))
    routes_moved = False
    for repo, head, candidates, routers in repos:  # did a router change, or a route file go, since frontend last mapped?
        stored = _hashes(con, "frontend", repo)
        by_file = _route_pages_by_file(con, repo)
        for src, pages in by_file.items():
            cur = candidates.get(src)
            if cur is None or cur[0] != "frontend" or (len(pages) > 1 and stored.get(src) != cur[2]):
                routes_moved = True
        # a new router file, or a one-route file that now holds several: its new pages render components whose
        # files didn't change, so only a full pass puts their locators there
        if stored and any(rel not in stored or (len(by_file.get(rel, ())) == 1 and stored[rel] != candidates[rel][2])
                          for rel in routers):
            routes_moved = True
    old_snap = meta(con, "codemap_routes_at_scan")  # an unresolved snapshot (a frontend that never fully landed) merges
    set_meta(con, "codemap_routes_at_scan", json.dumps(sorted(_route_pages(con) | set(json.loads(old_snap) if old_snap else []))))
    set_meta(con, "codemap_lost", "[]")
    set_meta(con, "codemap_scan_repos", json.dumps([r[0] for r in repos]))
    areas = {a: [] for a in CODEMAP_AREAS}
    for repo, head, candidates, _ in repos:
        for a in CODEMAP_AREAS:
            mine = {rel: (size, h) for rel, (area, size, h) in candidates.items() if area == a}
            stored = _hashes(con, a, repo)
            had = {r[0] for r in con.execute("SELECT DISTINCT src FROM codemap WHERE repo=? AND area=?", (repo, a))} | set(stored)
            # orphaned by a removed route, or listed by an earlier scan whose map never landed: read again
            forced = _meta_set(con, f"codemap_reread:{a}:{repo}") | _meta_set(con, f"codemap_pending:{a}:{repo}")
            if full or not had or (routes_moved and a in ("frontend", "tests")):
                entry = {"path": repo, "commit": head, "full": True, "files": sorted(mine),
                         "deleted": sorted(rel for rel in had if rel not in mine)}  # used when the area is chunked
            else:
                summary["incremental"] = True
                entry = {"path": repo, "commit": head, "full": False,
                         "files": sorted(rel for rel, (_, h) in mine.items() if stored.get(rel) != h or rel in forced),
                         # renamed away, deleted, reverted out, or no longer this area's: their rows must go
                         "deleted": sorted(rel for rel in had if rel not in mine)}
            entry["hashes"] = {rel: mine[rel][1] for rel in entry["files"]}
            entry["sizes"] = {rel: mine[rel][0] for rel in entry["files"]}
            entry["bytes"] = sum(entry["sizes"].values())
            with con:
                _set_meta_set(con, f"codemap_pending:{a}:{repo}", entry["files"])  # cleared as maps land
                if not entry["files"]:  # nothing for a mapper: settle it now so cards don't say "behind" forever
                    if entry["full"]:
                        con.execute("DELETE FROM codemap WHERE repo=? AND area=?", (repo, a))
                    for rel in entry["deleted"]:
                        con.execute("DELETE FROM codemap WHERE repo=? AND area=? AND src=?", (repo, a, rel))
                    if head:
                        set_meta(con, f"codemap_commit:{a}:{repo}", head)
                    _set_hashes(con, a, repo, {} if entry["full"] else
                                {k: v for k, v in stored.items() if k not in entry["deleted"]})
                    _set_meta_set(con, f"codemap_reread:{a}:{repo}", [])
                    entry["settled"] = True
            areas[a].append(entry)
    with con:
        _resolve_routes(con)  # all frontend settled here: judge orphans now
        _drop_code_only_pages(con)
    for a, entries in areas.items():
        chunks = _chunk(entries, chunk_files, chunk_tokens)
        info = []
        for n, chunk in enumerate(chunks, 1):
            suffix = "" if len(chunks) == 1 else f"-{n}"
            data = {"scan_id": f"{a}{suffix}-{stamp}", "area": a,
                    "repos": [{k: v for k, v in r.items() if k != "sizes"} for r in chunk]}
            scan_file = out_dir / f"scan-{a}{suffix}.json"
            scan_file.write_text(json.dumps(data, indent=1))
            files = sum(len(r["files"]) for r in chunk)
            if files:
                info.append({"scan_file": str(scan_file), "scan_id": data["scan_id"],
                             "out": str(out_dir / f"code-map-{a}{suffix}.json"), "files": files})
        n = sum(len(r["files"]) for r in entries)
        tokens = sum(r["bytes"] for r in entries) // 4
        summary["areas"][a] = {"files": n, "deleted": sum(len(r["deleted"]) for r in entries), "tokens": tokens,
                               "needs_mapper": n > 0, "mappers": info}
        summary["total_files"] += n
        summary["tokens"] += tokens
    return summary


def _chunk(entries, chunk_files, chunk_tokens):
    """Split an area's repo entries into mapper-sized chunks. A chunked area is replaced file by file: each chunk
    re-maps its own files, and the deletions (files gone or no longer this area's) ride in the repo's first chunk,
    so chunks can be ingested in any order without wiping each other's rows."""
    if sum(len(e["files"]) for e in entries) <= chunk_files and sum(e["bytes"] for e in entries) // 4 <= chunk_tokens:
        return [entries]
    chunks, cur, n_files, n_bytes = [], [], 0, 0

    def part_for(e, first):
        part = next((x for x in cur if x["path"] == e["path"]), None)
        if part is None:
            part = {"path": e["path"], "commit": e["commit"], "full": False, "files": [], "hashes": {},
                    "deleted": e["deleted"] if first else [], "bytes": 0}
            cur.append(part)
        return part

    for e in entries:
        first = True
        if not e["files"]:
            part_for(e, True)
            continue
        for rel in e["files"]:
            if cur and (n_files + 1 > chunk_files or (n_bytes + e["sizes"].get(rel, 0)) // 4 > chunk_tokens):
                chunks.append(cur)
                cur, n_files, n_bytes = [], 0, 0
            part = part_for(e, first)
            first = False
            part["files"].append(rel)
            part["hashes"][rel] = e["hashes"].get(rel, "")
            part["bytes"] += e["sizes"].get(rel, 0)
            n_files += 1
            n_bytes += e["sizes"].get(rel, 0)
    if cur:
        chunks.append(cur)
    return chunks


def _meta_set(con, key):
    try:
        return set(json.loads(meta(con, key) or "[]"))
    except (ValueError, TypeError):  # TypeError: not a list of strings
        return set()


def _hashes(con, area, repo):
    """{file: sha1 of its content when last mapped} for one area of one repo."""
    try:
        h = json.loads(meta(con, f"codemap_hashes:{area}:{repo}") or "{}")
        return h if isinstance(h, dict) else {}
    except ValueError:
        return {}


def _set_hashes(con, area, repo, hashes):
    set_meta(con, f"codemap_hashes:{area}:{repo}", json.dumps(dict(sorted(hashes.items()))))


def _set_meta_set(con, key, items):
    set_meta(con, key, json.dumps(sorted(set(items))))


def _resolve_routes(con):
    """Once every frontend file of the current scan has landed: routes present at scan time and gone now are lost.
    Rows other files put on them are orphans: drop them and list those files again (they land on the new path)."""
    scanned = json.loads(meta(con, "codemap_scan_repos") or "[]")  # a folder not in this scan can't move routes now
    if any(_meta_set(con, f"codemap_pending:frontend:{repo}") for repo in scanned):
        return  # frontend chunks still pending: a route may just be on its way from another file
    snapshot = meta(con, "codemap_routes_at_scan")
    if not snapshot:
        return
    lost = set(json.loads(snapshot)) - _route_pages(con)
    for page in lost:
        for repo, area, src in con.execute("SELECT DISTINCT repo, area, src FROM codemap WHERE page=? AND kind!='route' "
                                           "AND area IN ('frontend','tests')", (page,)).fetchall():
            con.execute("DELETE FROM codemap WHERE page=? AND repo=? AND area=? AND src=?", (page, repo, area, src))
            _set_meta_set(con, f"codemap_reread:{area}:{repo}", _meta_set(con, f"codemap_reread:{area}:{repo}") | {src})
            h = _hashes(con, area, repo)  # its rows are gone: never "unchanged since mapped"
            if h.pop(src, None) is not None:
                _set_hashes(con, area, repo, h)
    _set_meta_set(con, "codemap_lost", lost)
    set_meta(con, "codemap_routes_at_scan", "")  # judged once per scan


def _drop_code_only_pages(con):
    """Pages that exist only because of the code map, once their rows are gone (a route removed from the code)."""
    con.execute("DELETE FROM pages WHERE build IS NULL AND route NOT IN (SELECT page FROM codemap) "
                "AND route NOT IN (SELECT page FROM facts) AND route NOT IN (SELECT page FROM locators) "
                "AND route NOT IN (SELECT page FROM coverage) AND route NOT IN (SELECT coalesce(page,'') FROM bugs)")


def _row_src(repo, file):
    """'src/x.tsx' from 'src/x.tsx:12', './src/x.tsx' or '<repo>/src/x.tsx:12'."""
    rel = re.sub(r":\d[\d:-]*$", "", str(file or "").strip()[:500])  # capped, no backtracking
    if os.path.isabs(rel) and rel.startswith(repo.rstrip("/") + "/"):
        rel = rel[len(repo.rstrip("/")) + 1:]
    return rel[2:] if rel.startswith("./") else rel


def ingest_codemap(con, cm, f, ts=None):
    """Upsert qa-out/init/code-map-<area>.json (rows a qa-mapper wrote) using scan-<area>.json next to it for the
    repos, commits and which files were read. Rows from re-read or deleted files replace their old rows. A map whose
    rows mostly don't fit the scan (wrong repo or file paths) is rejected, so the mapper is told and nothing is lost."""
    ts = ts or now()
    if not isinstance(cm, dict):
        raise ValueError("code-map must be an object")
    area = cm.get("area")
    if area not in CODEMAP_AREAS:
        raise ValueError(f"'area' must be one of {', '.join(CODEMAP_AREAS)}")
    m = re.fullmatch(r"code-map-(\w+(?:-\d+)?)\.json", Path(f).name)
    scan_path = Path(f).with_name(f"scan-{m.group(1) if m else area}.json")
    try:
        scan = json.loads(scan_path.read_text())
    except (OSError, ValueError) as e:
        raise ValueError(f"{scan_path.name} is missing or unreadable ({e}); run qa-mem codemap-scan first")
    if not isinstance(scan, dict) or not isinstance(scan.get("repos") or [], list):
        raise ValueError(f"{scan_path.name} is not a scan file; run qa-mem codemap-scan again")
    if cm.get("scan_id") != scan.get("scan_id"):
        raise ValueError(f"scan_id {cm.get('scan_id')!r} doesn't match {scan_path.name} ({scan.get('scan_id')!r}): "
                         "the map is from an older scan; map the current scan file")
    if scan.get("area") != area:
        raise ValueError(f"area {area!r} doesn't match {scan_path.name} ({scan.get('area')!r})")
    repos = {}
    for r in scan.get("repos") or []:
        path = r.get("path") if isinstance(r, dict) else None
        if isinstance(path, str) and os.path.isabs(path) and os.path.isdir(path):
            repos[os.path.realpath(path)] = {**r, "files": _strs(r, "files"), "deleted": _strs(r, "deleted")}
    rows = dicts(cm, "rows")
    for x in rows:
        for fld in ("page", "kind", "label", "value", "file", "repo"):
            txt(x.get(fld), f"rows.{fld}")
    with_files = [p for p, r in repos.items() if r.get("files")]
    read = {path: set(r.get("files") or []) for path, r in repos.items()}
    kept, dropped = [], {}
    for x in rows:
        raw_repo = str(x.get("repo") or "").rstrip("/")
        repo = os.path.realpath(os.path.expanduser(raw_repo)) if raw_repo else (with_files[0] if len(with_files) == 1 else "")
        kind, label = str(x.get("kind") or "").lower(), cap(x.get("label"))[:120]
        src = _row_src(repo, x.get("file")) if repo else ""
        page_raw = str(x.get("page") or "*").strip()
        why = ("unknown repo" if repo not in repos else "unknown kind" if kind not in CODEMAP_KINDS
               else "no label" if not label else "file not in the scan" if src not in read[repo]
               else "route outside frontend" if kind == "route" and (area != "frontend" or page_raw in ("*", ""))
               else "page * outside backend (no card shows it)" if area != "backend" and page_raw in ("*", "")
               else None)
        if why:
            dropped[why] = dropped.get(why, 0) + 1
        else:
            kept.append((x, repo, kind, label, src))
    path_drops = dropped.get("unknown repo", 0) + dropped.get("file not in the scan", 0)
    if path_drops:  # rows that can't be placed would be lost for good (their files count as read): have them fixed
        bad = sorted({str(x.get("file")) for x in rows if not any(x is k[0] for k in kept)})[:5]
        raise ValueError(f"{path_drops} of {len(rows)} rows have a repo or file that isn't in {scan_path.name} "
                         f"(e.g. {bad}); every row's repo and file must be one listed there, relative to repos[].path. "
                         "Only the mapper whose out= is this file fixes it; others ignore this")
    lost = _meta_set(con, "codemap_lost")
    with con:
        for path, r in repos.items():
            if r.get("full"):
                con.execute("DELETE FROM codemap WHERE repo=? AND area=?", (path, area))
            else:
                for rel in (r.get("files") or []) + (r.get("deleted") or []):
                    con.execute("DELETE FROM codemap WHERE repo=? AND area=? AND src=?", (path, area, rel))
        pages, aimed_at_lost, placed = set(), {}, set()
        routed_now = _route_pages(con) | {norm_route(str(x.get("page") or "")) for x, _, k, _, _ in kept if k == "route"}
        for x, repo, kind, label, src in kept:
            raw_page = str(x.get("page") or "*").strip()
            page = "*" if raw_page in ("*", "") else (norm_route(raw_page) or "/")
            if kind != "route" and page in lost and page not in routed_now and area in ("frontend", "tests"):
                aimed_at_lost.setdefault(repo, set()).add(src)  # placed with an old route list: read it again
                dropped["on a removed route"] = dropped.get("on a removed route", 0) + 1
                continue
            value = cap(x.get("value"))
            # a config row like 'jwt.secret' = '...' (redact_json keys on `name`; code-map rows use `label`)
            ident = re.split(r"[\s./:\[\]]+", label.strip())[-1] if label.strip() else ""
            # only a bare literal: 'min 8, max 64', 'minLength=8' and 'POST /api/auth/reset-password' are the map itself
            # only a bare token is a secret: 'min 8, max 64', 'string|min:8', 'digits:6', 'z.string().min(8)' are rules
            named = SECRET_NAME_RE.match(ident) or re.search(rf"(?i)\b(?:{SECRET_KEYS})\b", label)  # 'Mapbox API key'
            if kind == "rule" and named and re.fullmatch(r"[A-Za-z0-9._~+-]{12,}", value.strip()) and re.search(r"\d", value) \
                    and _secret_looking(value) and not re.match(r"(?i)(min|max|len|required|pattern)", value.strip()):
                value = "[REDACTED]"
            n, base_label = 2, label  # two rows of one file under one label: both kept
            while (page, kind, label, repo, src) in placed:
                label, n = f"{base_label[:114]} ({n})", n + 1
            placed.add((page, kind, label, repo, src))
            con.execute("INSERT OR REPLACE INTO codemap(page,kind,label,value,file,repo,area,src,ts) "
                        "VALUES(?,?,?,?,?,?,?,?,?)",
                        (page, kind, label, value, cap(x.get("file")), repo, area, src, ts))
            if page != "*":  # cards and page-name lookups resolve it, whichever kind of row named the page
                pages.add(page)
                con.execute("INSERT INTO pages(route, name) VALUES(?,?) ON CONFLICT(route) DO UPDATE SET "
                            "name=coalesce(name, excluded.name)", (page, label if kind == "route" else None))
        for page in pages:  # page '*' holds the whole backend: never capped; route rows are never evicted
            con.execute("DELETE FROM codemap WHERE page=? AND rowid NOT IN (SELECT rowid FROM codemap WHERE page=? "
                        "ORDER BY kind='route' DESC, ts DESC, kind='api' DESC, rowid LIMIT ?)",
                        (page, page, CODEMAP_PAGE_CAP))
        for path, r in repos.items():
            files, gone = set(r.get("files") or []), set(r.get("deleted") or [])
            hashes = {} if r.get("full") else {k: v for k, v in _hashes(con, area, path).items() if k not in gone}
            given = r.get("hashes") if isinstance(r.get("hashes"), dict) else {}
            hashes.update({rel: str(given.get(rel) or "") for rel in files})
            for rel in aimed_at_lost.get(path, set()):
                hashes.pop(rel, None)  # placed on a removed route: read it again next scan
            _set_hashes(con, area, path, hashes)
            again = (_meta_set(con, f"codemap_reread:{area}:{path}") - files - gone) | aimed_at_lost.get(path, set())
            _set_meta_set(con, f"codemap_reread:{area}:{path}", again)
            pending = _meta_set(con, f"codemap_pending:{area}:{path}") - files - gone
            _set_meta_set(con, f"codemap_pending:{area}:{path}", pending)
            if not pending and COMMIT_RE.fullmatch(str(r.get("commit") or "")):  # every chunk of this area landed
                set_meta(con, f"codemap_commit:{area}:{path}", r["commit"])
        _resolve_routes(con)
        _drop_code_only_pages(con)
    return dropped


def _codemap_behind(con, rows):
    """'<sha>' or '<sha>, 12 commits behind' for the repos these rows came from (a card's backend rows included);
    one note per repo when several. Only commits that touch the mapped folder count."""
    notes = {}
    for repo, area in sorted({(x["repo"], x["area"]) for x in rows}):
        commit = meta(con, f"codemap_commit:{area}:{repo}")
        if not COMMIT_RE.fullmatch(commit or ""):
            continue
        # a card is read on every page: a slow or hung git (network share) costs 2 s once, then counts are left out
        behind = "" if GIT_SLOW else (_git(repo, "rev-list", "--count", "--end-of-options", f"{commit}..HEAD", "--", ".",
                                           timeout=2) or "").strip()
        n = int(behind) if behind.isdigit() else 0
        if repo not in notes or n > notes[repo][0]:  # areas of one repo: the furthest behind
            notes[repo] = (n, commit[:7] + (f", {n} commits behind" if n else ""))
    if len(notes) > 1:
        return "; ".join(f"{os.path.basename(repo)} {note}" for repo, (_, note) in sorted(notes.items()))
    return next(iter(notes.values()))[1] if notes else "not from git"


HTTP_METHODS = r"GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS"


def _api_ref(text):
    """(METHOD or '', 'api/zones/:id') from 'POST /api/zones/{id:int}', "fetch(`${BASE}/zones/${encodeURIComponent(id)}`)",
    "'/api/zones/' + id", 'https://h/api/x', "api.get('zones')": the lowercase shape a frontend call and a backend route
    share. ('', '') when there is no path."""
    t = str(text or "").strip()[:500]
    m = re.match(rf"({HTTP_METHODS})\s", t, re.I) or re.search(rf"\.({HTTP_METHODS})\s*(?:<[^()]*?>)?\s*\(", t, re.I)
    method = m.group(1).upper() if m else ""  # a leading verb or a client call, never a word inside the path
    t = re.sub(r"https?://[^/\s'\"`]+", "", t)  # scheme and host
    t = re.sub(r"(^|['\"`(\s])\$\{[^}]*\}/", r"\1/", t)  # a leading ${BASE}/ style prefix, whatever it is called
    t = re.sub(r"\$\{[^}]*\}", ":id", t)  # other template expressions are values: ${id}, ${encodeURIComponent(id)}
    t = re.sub(r"\{(\w+)(:[^}]*)?\}", r"{\1}", t)  # typed params: {id:int}, {id:guid}
    t = re.sub(r"(:\w+)\([^)]*\)", r"\1", t)  # :id(\d+)
    t = re.sub(r"(['\"`])\s*\+\s*[^'\"`+]+?\s*\+\s*['\"`]", ":id", t)  # '/a/' + id + '/b' -> '/a/:id/b'
    t = re.sub(r"(['\"`])\s*\+\s*[\w.()]+", r":id\1", t) if re.search(r"/['\"`]\s*\+", t) else t  # '/api/zones/' + id
    m = re.search(r"(?:^|[\s'\"`(])/?((?:[\w.{}$:\[\]<>-]+/)+[\w.{}$:\[\]<>-]+)", t) or \
        re.search(rf"(?:^(?:{HTTP_METHODS})\s+/|['\"`]/)([\w.-]+)", t, re.I) or \
        re.search(rf"\.(?:{HTTP_METHODS})\s*(?:<[^()]*?>)?\s*\(\s*['\"`]/?([\w.-]+)['\"`]", t, re.I)  # api.get('zones')
    if not m:
        return method, ""
    path = re.sub(r"\.(json|xml)$", "", m.group(1).split("?")[0].strip("/"))
    segs = [seg if seg.lower() in ("[controller]", "[action]") else
            ":id" if re.fullmatch(r"\{\w+\}|:\w+|\d+|\[\.{0,3}\w+\]|<[^>]+>", seg) else seg
            for seg in path.replace(":id:id", ":id").split("/") if seg]
    return method, "/".join(segs).lower()


def _api_path(text):
    return _api_ref(text)[1]


API_BASE_SEG_RE = re.compile(r"api|rest|v\d+(\.\d+)?|[\w-]+-api|api-[\w-]+")


def _same_endpoint(a, b):
    """Two call shapes name one endpoint: equal, or the longer only adds base segments in front (api/zones = zones,
    api/v1/zones = v1/zones); never a router-relative tail (:id/status) or another resource (api/admin/zones)."""
    if a == b:
        return True
    s, l = sorted((a.split("/"), b.split("/")), key=len)
    return len(s) < len(l) and s[0] != ":id" and l[len(l) - len(s):] == s \
        and all(API_BASE_SEG_RE.fullmatch(x) for x in l[:len(l) - len(s)])


def _codemap_rows(con, route):
    """This page's rows plus the backend rows ('*') for the endpoints its frontend calls (same path; same method
    when both sides name one)."""
    rows = con.execute("SELECT kind,label,value,file,repo,area FROM codemap WHERE page=? ORDER BY kind, label",
                       (route,)).fetchall()
    called = set()
    for x in rows:
        if x["kind"] == "api":
            ref = _api_ref(x["value"]) if _api_ref(x["value"])[1] else _api_ref(x["label"])
            if ref[1]:
                called.add(ref)
    if called and route != "*":
        for x in con.execute("SELECT kind,label,value,file,repo,area FROM codemap WHERE page='*' AND kind IN ('api','rule') "
                             "ORDER BY kind, label"):
            m, p = _api_ref(x["label"]) if _api_ref(x["label"])[1] else _api_ref(x["value"])
            if p and any(_same_endpoint(p, c) and (not m or not cm or m == cm) for cm, c in called):
                rows.append(x)
    return rows


def codemap_block(con, route, shown=None):
    """Card lines for the code map: compact (about 12 lines); `qa-mem code <route>` has everything."""
    all_rows = _codemap_rows(con, route)
    rows = [x for x in all_rows if x["kind"] != "route"]
    if not rows:
        return []
    # Verified locators the card already printed; any it had no room for still show here as hints
    seen = shown if shown is not None else \
        {x["locator"] for x in con.execute("SELECT locator FROM locators WHERE page=? AND stale=0", (route,))}
    by = {k: [x for x in rows if x["kind"] == k] for k in ("locator", "rule", "api")}
    uniq = {}
    for x in by["locator"]:  # confirmed by a run: shown above already; the same locator from two files: once
        if x["value"] not in seen:
            uniq.setdefault(x["value"], x)
    by["locator"] = list(uniq.values())
    limits, out = {"locator": 15, "rule": 6, "api": 4}, []
    out.append(f"FROM CODE (hints from source, not requirements; unverified; {_codemap_behind(con, all_rows)}):")
    if by["locator"]:
        out.append("- locators to try: " + "; ".join(f"{short(x['label'], 40)}={x['value']}"
                                                  for x in by["locator"][:limits["locator"]]))
    for k, title in (("rule", "rules in code"), ("api", "endpoints called")):
        if by[k]:
            out.append(f"- {title}: " + "; ".join(f"{short(x['label'], 50)}: {short(x['value'], 80)}"
                                                 for x in by[k][:limits[k]]))
    more = sum(max(0, len(by[k]) - limits[k]) for k in limits)
    if more:
        out.append(f"- (+{more} more: qa-mem code '{route}')")
    return out if len(out) > 1 else []


def codemap_repos(con):
    """[(repo, rows, exists)] for every source folder the code map knows (rows, or only bookkeeping such as a map
    that never landed)."""
    counts = {r["repo"]: r["n"] for r in con.execute("SELECT repo, count(*) AS n FROM codemap GROUP BY repo")}
    for (key,) in con.execute("SELECT key FROM meta WHERE key LIKE 'codemap_%:%:%'"):
        repo = key.split(":", 2)[2]
        counts.setdefault(repo, 0)
    return [(repo, n, os.path.isdir(repo)) for repo, n in sorted(counts.items())]


def codemap_forget(con, repo):
    """Drop one source folder's rows and commits (a moved, re-cloned or retired repo). Returns rows removed, or None
    when the code map knows no such folder. A folder that is gone matches as typed (~, trailing /, relative)."""
    p = os.path.expanduser(repo)
    keys = {repo, os.path.realpath(p), os.path.normpath(os.path.abspath(p))}
    known = {r[0] for r in codemap_repos(con)} & keys
    if not known:
        return None
    n = 0
    with con:
        for key in known:
            n += con.execute("DELETE FROM codemap WHERE repo=?", (key,)).rowcount
            for a in CODEMAP_AREAS:
                con.execute("DELETE FROM meta WHERE key IN (?,?,?,?)", (f"codemap_commit:{a}:{key}", f"codemap_hashes:{a}:{key}",
                                                                       f"codemap_reread:{a}:{key}", f"codemap_pending:{a}:{key}"))
        _drop_code_only_pages(con)
    return n


def code(con, q=""):
    """`code`: every route known from source. `code <route|name>`: every code-map row for that page.
    `code --repos`: the source folders mapped (a folder that no longer exists is flagged)."""
    if q.strip() == "--repos" and codemap_repos(con):  # also folders with bookkeeping only (a map that never landed)
        return "MAPPED SOURCE FOLDERS:\n" + "\n".join(
            f"{repo}  {n} rows" + ("" if exists else "  (folder no longer exists: qa-mem codemap-forget '<it>')")
            for repo, n, exists in codemap_repos(con))
    if not con.execute("SELECT 1 FROM codemap LIMIT 1").fetchone():
        return "no code map yet: run /qa-sdet:qa-init to map routes, locators, rules and endpoints from the source"
    if not q.strip():
        rows = con.execute("SELECT page,label,file FROM codemap WHERE kind='route' AND area='frontend' AND page!='*' "
                           "ORDER BY page").fetchall()
        n = {k: c for k, c in con.execute("SELECT kind, count(*) FROM codemap GROUP BY kind")}
        n_star = con.execute("SELECT count(*) FROM codemap WHERE page='*' AND kind='api'").fetchone()[0]
        return ("ROUTES FROM CODE:\n" + ("\n".join(f"{x['page']}  {x['label']}  ({x['file']})" for x in rows)
                                         or "(none: no frontend routes mapped yet)")
                + f"\nTOTAL: {len(rows)} routes, {n.get('locator', 0)} locators, {n.get('rule', 0)} rules, "
                  f"{n.get('api', 0)} endpoints ({n_star} backend: qa-mem code '*')")
    pg = find_page(con, q)
    route = pg["route"] if pg else ("*" if q.strip() == "*" else norm_route(q))
    rows = _codemap_rows(con, route)
    if not rows:
        return f"no code-map rows for '{q}'"
    return f"CODE MAP {route} ({_codemap_behind(con, rows)}; hints from source, not requirements):\n" + "\n".join(
        f"[{x['kind']}] {x['label']} = {x['value']}  ({x['file']})" for x in rows)


def find_page(con, q):
    """Routes ('/x') match exactly; anything else matches a route or page name fuzzily."""
    q = q.strip()
    if not q:
        return None
    if q.startswith("/") or "://" in q:
        return con.execute("SELECT * FROM pages WHERE route=?", (norm_route(q),)).fetchone()
    esc = q.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
    like, seg = f"%{esc}%", f"%/{esc}%"
    # Best first: the route itself (/zones, /zones.html), the exact page name, a route segment starting with
    # the word (/map.html before /roadmap), then the shortest route.
    return con.execute("SELECT * FROM pages WHERE route LIKE ? ESCAPE '\\' OR name LIKE ? ESCAPE '\\' OR route IN "
                       "(SELECT page FROM codemap WHERE kind='route' AND label LIKE ? ESCAPE '\\') "
                       "ORDER BY (route = ? OR route LIKE ? ESCAPE '\\') DESC, lower(coalesce(name, '')) = lower(?) DESC, "
                       "route IN (SELECT page FROM codemap WHERE kind='route' AND lower(label)=lower(?)) DESC, "
                       "route LIKE ? ESCAPE '\\' DESC, length(route) LIMIT 1",
                       (like, like, like, "/" + q, f"/{esc}.%", q, q, seg)).fetchone()


def short(s, n):
    s = str(s or "")
    return s if len(s) <= n else s[:n - 1] + "…"


def card(con, q):
    pg = find_page(con, q)
    if not pg:
        tip = "" if con.execute("SELECT 1 FROM codemap LIMIT 1").fetchone() else \
            "tip: /qa-sdet:qa-init maps routes and locators from your source, so pages resolve by name\n"
        return (f"NO CARD for '{q}': first visit. Untried heuristics: {', '.join(HEURISTICS)}\n" + tip
                + bug_lines(con, None))
    r = pg["route"]
    b = meta(con, "build") or pg["build"]  # coverage only counts on the build deployed now
    unknown_page = pg["build"] == UNKNOWN  # its build was never readable (e.g. a map page without the footer)
    code_only = pg["build"] is None  # known from the code map only: nothing observed yet, nothing to re-verify
    current = pg["build"] == b or unknown_page or code_only
    out = [f"PAGE {r} \"{pg['name'] or ''}\" build={pg['build']} verified={pg['last_verified'] or 'never'}"
           + ("" if norm_route(q) == r else f"  (matched from '{q}')")]
    if code_only:
        out.append("NOTE: known from source code only; no run has visited it yet.")
    elif not current:
        out.append(f"NOTE: current build is {b}; everything below is from build {pg['build']}: re-verify.")
    elif unknown_page and b != UNKNOWN:
        out.append(f"NOTE: this page's build was never readable; its knowledge may predate build {b}.")
    facts, seen = [], []
    for f in con.execute("SELECT kind,text,stale,source FROM facts WHERE page=? ORDER BY stale, ts DESC LIMIT 60",
                         (r,)):
        words = set(norm(f["text"]).split())
        # Runs restate facts in new words; show only the freshest of near-duplicates.
        if any(k == f["kind"] and len(words & w) >= 0.8 * max(len(words | w), 1)
               and not any(x.isdigit() for x in words ^ w) for k, w in seen):  # '130' vs '120' is news, not a repeat
            continue
        seen.append((f["kind"], words))
        facts.append(f)
        if len(facts) == 15:
            break
    if facts:
        out.append("FACTS (* = stale, re-verify; 'from X' = stated in X, not yet observed):")
        out += [f"- [{f['kind']}] {f['text']}"
                + (f" (from {f['source']})" if f["source"] and f["source"].lower() != "observed" else "")
                + (" *" if f["stale"] or not current else "") for f in facts]
    shown = set()
    if current:
        locs, size = [], 0
        rows = con.execute("SELECT name,locator FROM locators WHERE page=? AND stale=0 ORDER BY last_verified DESC",
                           (r,)).fetchall()
        for x in rows:
            entry = f"{short(x['name'], 40)}={x['locator']}"  # locators stay whole: a cut one is useless
            if len(locs) >= 20 or size + len(entry) > 2000:
                break
            locs.append(entry)
            shown.add(x["locator"])
            size += len(entry)
        if locs:
            more = f" (+{len(rows) - len(locs)} more verified; find them with a snapshot)" if len(rows) > len(locs) else ""
            out.append("LOCATORS (fresh): " + "; ".join(locs) + more)
    out += codemap_block(con, r, shown if current else None)
    cov = {}
    # Coverage from runs that couldn't read the build counts for a week, then the heuristic is retried.
    week_ago = datetime.fromtimestamp(time.time() - 7 * 86400, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    for c in con.execute("SELECT heuristic, target, result FROM coverage WHERE page=? AND ((build=? AND "
                         "build!='unknown') OR (build='unknown' AND ts >= ?)) ORDER BY heuristic, result='pass', ts DESC",
                         (r, b, week_ago)):  # failures first
        cov.setdefault(c["heuristic"], []).append(f"{short(c['target'], 40)}:{short(c['result'], 12)}")
    # A heuristic only blocked (e.g. needs --faults) is still untried: the next run may be able to do it.
    tried = {h for h, t in cov.items() if any(not x.endswith(":blocked") for x in t)}
    if cov:  # at most 4 targets per heuristic keeps the card short
        out.append(f"COVERED on build {b} (only-blocked ones are retried, listed in UNTRIED): " + " | ".join(
            f"{h}({', '.join(t[:4])}{f', +{len(t) - 4} more' if len(t) > 4 else ''})" for h, t in cov.items()))
    out.append("UNTRIED: " + (", ".join(h for h in HEURISTICS if h not in tried) or "none"))
    out.append(bug_lines(con, r))
    return "\n".join(x for x in out if x)


def bug_lines(con, route):
    q = "SELECT hash,page,severity,status,title,symptom,seen_count FROM bugs WHERE status IN (?,?,?)"
    args = list(VISIBLE)
    if route is not None:
        q += " AND page=?"
        args.append(route)
    rows = con.execute(q + " ORDER BY last_seen DESC LIMIT 10", args).fetchall()
    fixed = con.execute("SELECT hash,page,severity,status,title,symptom,seen_count FROM bugs WHERE status='FIXED'"
                        + (" AND page=?" if route is not None else "") + " ORDER BY last_seen DESC LIMIT 5",
                        [route] if route is not None else []).fetchall()
    line = lambda x: (f"- {x['hash']} {x['status']} [{x['severity']}] "
                      + (f"{x['page']} " if route is None else "")  # app-wide list: say which page
                      + f"{short(x['title'], 100)} | symptom: {short(x['symptom'] or x['title'], 120)} (seen {x['seen_count']})")
    out = []
    if rows:
        out += ["KNOWN BUGS (don't re-draft; to report a sighting put its hash in run.json):"] + [line(x) for x in rows]
    if fixed:
        out += ["PREVIOUSLY FIXED (seen again = regression: put its hash in run.json):"] + [line(x) for x in fixed]
    invalid = con.execute("SELECT hash,page,severity,status,title,symptom,seen_count FROM bugs WHERE status='INVALID'"
                          + (" AND page=?" if route is not None else "") + " ORDER BY last_seen DESC LIMIT 5",
                          [route] if route is not None else []).fetchall()
    if invalid:
        out += ["NOT BUGS (the user marked these INVALID: don't report them):"] + [line(x) for x in invalid]
    return "\n".join(out)


def search(con, q):
    """Plain words, all required; `-word` excludes. Built here as an FTS query, so FTS operators typed in the terms
    (NEAR, AND, a leading -) can't change what is matched."""
    terms = [t for t in str(q).split() if t not in ("AND", "OR", "NOT", "NEAR") and re.search(r"\w", t)]
    pos, neg = [t for t in terms if not t.startswith("-")], [t[1:] for t in terms if t.startswith("-")]
    # '/api/zones', 'speed-limit', 'form.html': every word in a term counts (FTS indexes words)
    words, nots = [w for t in pos for w in re.findall(r"\w+", t)], [w for t in neg for w in re.findall(r"\w+", t)]
    rows = _search(con, " ".join(f'"{w}"' for w in words) + "".join(f' NOT "{w}"' for w in nots)) if words else []
    lines = [f"{x['page']} [{x['kind']}] {x['text']}" + (" *" if x["stale"] else "") for x in rows]
    if words:  # the code map too (incl. backend endpoints no page calls, page '*')
        cond = " AND ".join(["(label || ' ' || coalesce(value, '')) LIKE ? ESCAPE '\\'"] * len(pos)
                            + ["(label || ' ' || coalesce(value, '')) NOT LIKE ? ESCAPE '\\'"] * len(neg))
        like = lambda t: "%" + t.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%"  # the term as typed
        esc = [like(t) for t in pos + neg]
        lines += [f"{x['page']} [code:{x['kind']}] {x['label']} = {x['value']}" for x in con.execute(
            f"SELECT page,kind,label,value FROM codemap WHERE {cond} ORDER BY page='*', kind='route' DESC, page LIMIT 10",
            esc)]
    return "\n".join(lines) or f"no facts match '{q}'"


def _search(con, q):
    return con.execute("SELECT f.page,f.kind,f.text,f.stale FROM facts_fts JOIN facts f ON f.id=facts_fts.rowid "
                       "WHERE facts_fts MATCH ? ORDER BY rank LIMIT 20", (q,)).fetchall()


def bugs(con, status="OPEN"):
    total = con.execute("SELECT count(*) FROM bugs WHERE status=?", (status,)).fetchone()[0]
    rows = con.execute("SELECT * FROM bugs WHERE status=? ORDER BY last_seen DESC LIMIT 30", (status,)).fetchall()
    lines = [f"{x['hash']} [{x['severity']}] {x['classification']} {x['page']} {short(x['title'], 100)} "
             f"(seen {x['seen_count']}) {x['draft_path'] or ''}" for x in rows]
    if total > len(rows):
        lines.append(f"... {total - len(rows)} older {status} bugs not shown (search facts or ask for a page's card)")
    return "\n".join(lines) or f"no {status} bugs"


def installed_browsers(names=BROWSERS):
    """{name: (installed, where or how to install)}. chrome and msedge are the system browsers (Playwright's
    channel paths); firefox and webkit are Playwright's own builds: a system Firefox can't be driven."""
    import shutil
    import subprocess
    env = os.environ  # Windows roots in Playwright's own lookup order (playwright-core _createChromiumChannel)
    roots = [r for r in (env.get("LOCALAPPDATA"), env.get("PROGRAMFILES"), env.get("PROGRAMFILES(X86)")) if r]
    if env.get("HOMEDRIVE"):
        roots += [env["HOMEDRIVE"] + r"\Program Files", env["HOMEDRIVE"] + r"\Program Files (x86)"]
    system = {
        "chrome": ("Google Chrome", ["/opt/google/chrome/chrome", "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"]
                   + [r + r"\Google\Chrome\Application\chrome.exe" for r in roots]),
        "msedge": ("Microsoft Edge", ["/opt/microsoft/msedge/msedge", "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"]
                   + [r + r"\Microsoft\Edge\Application\msedge.exe" for r in roots]),
    }
    pw, out = shutil.which("playwright-cli"), {}
    for name in names:
        if name in system:
            label, paths = system[name]
            hit = next((x for x in paths if os.path.isfile(x)), None)
            out[name] = (bool(hit), hit or f"install {label} the usual way for this system")
            continue
        loc, why = None, "can't check: playwright-cli isn't working (npm i -g @playwright/cli), then install-browser " + name
        if pw:
            why = f"can't check: `playwright-cli install-browser --dry-run {name}` gave no install location"
            try:
                dry = subprocess.run([pw, "install-browser", "--dry-run", name], capture_output=True, text=True,
                                     timeout=30).stdout
                m = re.search(r"Install location:\s*(.+)", dry)
                loc = m.group(1).strip() if m else None
            except (subprocess.TimeoutExpired, OSError):
                pass
        # Playwright writes INSTALLATION_COMPLETE last: a folder without it is an interrupted download
        ok = bool(loc) and (Path(loc) / "INSTALLATION_COMPLETE").is_file()
        out[name] = (ok, f"Playwright build {Path(loc).name}" if ok else f"playwright-cli install-browser {name}" if loc
                     else why)
    return out


def pillow_fix():
    """The install command that works here: pip refuses an OS-managed python3 (PEP 668: Debian/Ubuntu, Arch, Fedora,
    Homebrew), so name the OS package instead."""
    import shutil, sysconfig
    if not os.path.exists(os.path.join(sysconfig.get_paths()["stdlib"], "EXTERNALLY-MANAGED")):
        return f"{sys.executable} -m pip install --user pillow"
    for tool, cmd in (("brew", "brew install pillow"), ("apt-get", "sudo apt-get install python3-pil"),
                      ("dnf", "sudo dnf install python3-pillow"), ("pacman", "sudo pacman -S python-pillow"),
                      ("zypper", "sudo zypper install python3-Pillow")):
        if shutil.which(tool):
            return f"{cmd} (this python3 is OS-managed, so pip refuses)"
    return f"install your OS's Pillow package for {sys.executable} (it is OS-managed, so pip refuses)"


def claude_mcp_list():
    """`claude mcp list` output, or None when Claude Code isn't callable (it health-checks each server)."""
    import subprocess
    try:
        r = subprocess.run(["claude", "mcp", "list"], capture_output=True, encoding="utf-8", errors="replace",
                           timeout=30)
        return r.stdout if r.returncode == 0 or r.stdout.strip() else "FAILED"  # an error is not "no servers"
    except subprocess.TimeoutExpired:
        return "TIMEOUT"  # a first `npx @playwright/mcp@latest` download can take this long
    except OSError:
        return None


def doctor():
    """Setup check for a new machine. Prints one line per item; returns the number of problems.
    Subprocess timeouts sum to under 2 minutes (15 + 30 + 30 + 30 s) so a skill's Bash call never cuts it off."""
    import shutil
    import subprocess
    import time
    problems = 0

    def line(ok, what, fix=""):
        nonlocal problems
        problems += not ok
        print(f"{'ok  ' if ok else 'FIX '} {what}" + (f"  -> {fix}" if fix and not ok else ""))

    line(sys.version_info >= (3, 9), f"python {sys.version.split()[0]}", "install Python 3.9+ as python3 (hooks need it)")
    try:
        chosen = json.loads(CONFIG.read_text()).get("browser")
    except (OSError, ValueError, AttributeError):
        chosen = None
    listing = []

    def mcp_servers(*words):
        """(connected, others) server names whose line mentions one of `words`. Names only: a line's command or URL can
        carry keys. This script can't see the session's tools, so it asks `claude mcp list`."""
        if not listing:
            listing.append(claude_mcp_list())
        hits = [ln.strip() for ln in ("" if listing[0] in (None, "TIMEOUT", "FAILED") else listing[0]).splitlines()
                if ": " in ln and " - " in ln and "test-mcp" not in ln  # not the Playwright Test MCP
                and (any(w in ln.split(": ", 1)[0].lower() for w in words)  # the server's name,
                     or any(w in ln.lower() for w in words if "/" in w or "." in w))]  # or its package / URL
        status = lambda ln: next((label for key, label in (("Connected", "connected"), ("Pending", "pending approval"),
                                                            ("auth", "needs sign-in"), ("Failed", "failed to connect"))
                                  if key in ln.rsplit(" - ", 1)[-1]), "not connected")  # fixed labels: error text can hold keys
        connected = [ln.split(": ", 1)[0] for ln in hits if status(ln) == "connected"]
        others = [f"{ln.split(': ', 1)[0]} ({status(ln)})" for ln in hits if status(ln) != "connected"]
        return connected, others

    pw, on_path, mcp_browser = shutil.which("playwright-cli"), bool(shutil.which("playwright-cli")), False
    if pw:  # on PATH isn't enough: a broken install must fall back too
        try:
            pw = pw if subprocess.run([pw, "--version"], capture_output=True, timeout=15).returncode == 0 else None
        except (subprocess.TimeoutExpired, OSError):
            pw = None
    if pw:
        line(True, "playwright-cli runs (--version)")
    else:
        found, other = mcp_servers("playwright", "browser", "@playwright/mcp")
        mcp_browser = bool(found)
        unknown = [n for n in mcp_servers("")[0] if n not in found]  # connected servers this check can't classify
        cli = "playwright-cli runs (--version)" if on_path else "playwright-cli on PATH"
        cli_fix = "reinstall: npm i -g @playwright/cli" if on_path else "npm i -g @playwright/cli"
        if mcp_browser:  # a working fallback: the CLI is a recommendation, not a problem
            print(f"info {cli}: no, runs use the Playwright MCP instead (for qa-login and recordings: {cli_fix})")
        else:
            line(False, cli, cli_fix)
        if listing[0] in (None, "TIMEOUT", "FAILED"):  # can't tell from here
            why = ("`claude` not on PATH" if listing[0] is None else "`claude mcp list` failed; run it to see why"
                   if listing[0] == "FAILED" else "`claude mcp list` timed out; run doctor again")
            print(f"info fallback browser: couldn't list MCP servers ({why}); runs look for browser_* tools themselves")
        elif mcp_browser or other or not unknown:
            line(mcp_browser, "fallback browser: " + ("Playwright MCP " + ", ".join(found) if found else "a connected Playwright MCP"),
                 ("connect or approve it in Claude Code (/mcp): " + ", ".join(other)) if other else
                 f"claude mcp add playwright -- npx @playwright/mcp@latest --isolated --browser {chosen if chosen in BROWSERS else '<browser>'}"
             + (f", then npx @playwright/mcp@latest install-browser {chosen}" if chosen in ("firefox", "webkit") else "")
             + " (or install playwright-cli)")
        else:  # this script sees names, not tools; runs check for a browser_navigate tool (common.md C0)
            print("info fallback browser: none named playwright/browser; runs use any connected MCP with browser_* tools "
                  f"(connected: {', '.join(unknown)})")
    if pw:  # runs open the browser the user chose (config `browser`); C1 asks for it from what's installed
        if chosen is None:
            line(False, "config has browser (chrome, msedge, firefox or webkit)",
                 "qa-explore / qa-ticket / qa-login ask you which installed browser to use (`qa-mem browsers` lists them)")
        elif chosen not in BROWSERS:
            line(False, f"config browser {chosen!r} is one of {', '.join(BROWSERS)}", "`qa-mem browsers` lists what's installed")
        else:
            ok_b, how = installed_browsers((chosen,))[chosen]
            if how.startswith("can't check"):  # the CLI works; only the lookup failed
                print(f"info browser {chosen}: {how}")
            else:
                line(ok_b, f"browser {chosen} installed" + (f" ({how})" if ok_b else ""), how)
    acli, ok = shutil.which("acli"), False
    if acli:
        try:
            ok = subprocess.run([acli, "jira", "auth", "status"], capture_output=True, encoding="utf-8",
                                errors="replace", timeout=30).returncode == 0
        except (subprocess.TimeoutExpired, OSError):
            ok = False
    if acli and ok:
        line(True, "acli signed in to Jira")
    else:
        found, other = mcp_servers("atlassian", "jira", "mcp.atlassian.com", "mcp-atlassian")
        if acli and found:  # a working fallback: signing in to acli is optional
            print("info acli not signed in: runs use the Jira MCP (to use acli: acli jira auth login)")
        elif acli:
            line(False, "acli signed in to Jira", "acli jira auth login")
        print(f"{'ok  ' if found else 'info'} Jira fallback: " + (
            "couldn't list MCP servers; runs look for Jira read tools, else you paste tickets"
            if listing[0] in (None, "TIMEOUT", "FAILED") else
            "Atlassian/Jira MCP " + ", ".join(found) if found else
            "Jira MCP not connected: " + ", ".join(other) + " (connect it in /mcp) or paste tickets" if other else
            "no acli or Jira MCP: tickets are pasted (optional: install acli or connect the Atlassian MCP)"))
    cfg, readable = {}, True
    try:
        cfg = json.loads(CONFIG.read_text())
        line(isinstance(cfg, dict), f"config {CONFIG}", 'the file must be one JSON object: {"app": ..., "qaBaseUrl": ...}')
    except (OSError, ValueError) as e:
        readable = not os.path.exists(CONFIG)  # a broken file: its keys can't be judged
        line(False, f"config {CONFIG} ({e.__class__.__name__})",
             f"fix the JSON ({e})" if isinstance(e, ValueError) else
             f"make it readable: chmod u+rwx {CONFIG.parent}; chmod u+rw {CONFIG}" if isinstance(e, PermissionError) else
             "run any qa-sdet skill once; it asks for the values")
    if isinstance(cfg, dict) and readable and (cfg or os.path.exists(CONFIG)):  # an existing `{}` still needs its keys named (os.path: Path.exists raises before 3.12)
        missing = [k for k in ("app", "qaBaseUrl", "allowedHosts", "ssoHost", "buildSource") if not cfg.get(k)]
        line(not missing, "config has app, qaBaseUrl, allowedHosts, ssoHost, buildSource", f"add {missing}")
        bs = cfg.get("buildSource")
        line(isinstance(bs, dict) and bs.get("type") in ("selector", "url", "header")
             and isinstance(bs.get("value"), str) and bool(bs["value"].strip()),
             "buildSource is {type: selector|url|header, value}", 'e.g. {"type": "selector", "value": "footer .version"}')
        hosts = cfg.get("allowedHosts")
        line(isinstance(hosts, list) and all(isinstance(h, str) for h in hosts), "allowedHosts is a list of hosts",
             'e.g. "allowedHosts": ["qa.example.com"]')
        norm_hosts = [h.lower().strip().rstrip(".").removeprefix("*.") for h in hosts
                      if isinstance(h, str)] if isinstance(hosts, list) else []  # same rules as the guard
        odd = [h for h in norm_hosts if h and not re.fullmatch(r"[a-z0-9._-]+|::1", h)]  # the guard matches host names only
        if {"localhost", "127.0.0.1", "::1"} & set(norm_hosts):  # loopback aliases, as in the guard
            norm_hosts += ["localhost", "127.0.0.1", "::1"]
        if odd:
            line(False, f"allowedHosts entries are host names ({', '.join(short(h, 40) for h in odd[:3])} can never match)",
                 'just the host, no https://, port or path: "https://qa.example.com:8443/app" -> "qa.example.com"')
        try:
            base_url = urlsplit(str(cfg.get("qaBaseUrl") or ""))
            base, base_host = (base_url.hostname or "").rstrip("."), base_url.netloc.rpartition("@")[2].lower()
        except ValueError:
            base = base_host = ""
        if cfg.get("qaBaseUrl") and not (base and str(cfg["qaBaseUrl"]).lower().startswith(("http://", "https://"))):
            line(False, "qaBaseUrl is a full URL", 'e.g. "qaBaseUrl": "https://qa.example.com"')
        elif base:
            line(any(base == h or base.endswith("." + h) for h in norm_hosts),
                 "qaBaseUrl host is in allowedHosts", "add the qaBaseUrl host to allowedHosts")
        sso = cfg.get("ssoHost")
        if sso and not (isinstance(sso, str) and re.fullmatch(r"[A-Za-z0-9.-]+(:\d+)?\.?", sso.strip())):
            line(False, "ssoHost is a host name", 'just the host, no https:// or path: e.g. "ssoHost": "login.microsoftonline.com"')
        elif sso:  # runs compare it with location.host
            line(sso.lower().strip().rstrip(".") not in (base.lower(), base_host), "ssoHost differs from the qaBaseUrl host",
                 "ssoHost is the login provider's host (e.g. login.microsoftonline.com); every run would end BLOCKED")
        prefix = cfg.get("jiraKeyPrefix")
        if prefix not in (None, ""):  # optional: lets the user type ticket numbers without the project key
            line(isinstance(prefix, str) and bool(re.fullmatch(r"[A-Z][A-Z0-9]+", prefix.strip().upper().rstrip("-"),
                                                               re.ASCII)),
                 "jiraKeyPrefix is a Jira project key", 'the letters before the ticket number: e.g. "jiraKeyPrefix": "STUDIO"')
    try:
        import PIL
        line(True, f"Pillow {PIL.__version__}")
    except ImportError:
        line(False, "Pillow (annotated bug images need it)", pillow_fix())
    if os.path.isfile(signed_in_stamp()) and os.path.isdir(profile_dir()):
        line(True, "signed-in profile present, from /qa-sdet:qa-login (expires with the app's session)")
    elif mcp_browser:
        print("info no signed-in profile: MCP runs ask you to sign in in the MCP's browser window")
    else:
        line(False, "signed-in browser profile", "run /qa-sdet:qa-login")
    if os.path.lexists(CONFIG.with_name("qa-state.json")):  # never opened: it holds cookies
        print("info old cookie file present: qa-setup can delete it")
    try:
        con = connect()
        n_pages, n_rows = con.execute("SELECT count(DISTINCT page), count(*) FROM codemap").fetchone()
        con.close()
        line(True, f"memory DB {db_path()}")
        paths = cfg.get("sourcePaths") if isinstance(cfg, dict) else None
        if paths is not None and not (isinstance(paths, list) and all(isinstance(x, str) and x for x in paths)):
            line(False, "sourcePaths is a list of folders", 'e.g. "sourcePaths": ["/home/me/work/app-ui"]')
        paths = [x for x in paths if isinstance(x, str) and x] if isinstance(paths, list) else []
        gone = [x for x in paths if not os.path.isdir(os.path.expanduser(x))]
        if gone:
            line(False, f"sourcePaths folders exist ({', '.join(short(x, 60) for x in gone)} not found)",
                 "fix the path in the config, or run /qa-sdet:qa-init with the right folders")
        print(f"ok   code map: {n_rows} rows on {n_pages} pages" if n_rows else
              "info no code map yet: /qa-sdet:qa-init maps routes, locators, rules and endpoints from your source"
              + (f" ({len(paths)} source folders configured)" if paths else ""))
        line(db_path().parent.stat().st_mode & 0o077 == 0, "memory DB folder readable only by you",
             f"chmod 700 {db_path().parent}")
    except (OSError, sqlite3.Error) as e:
        line(False, f"memory DB {db_path()} ({e})", "use a python3 whose sqlite3 has FTS5 (python.org or Homebrew builds do)"
             if "fts5" in str(e).lower() else f"check you can write to {db_path().parent}")
    return problems


# ---------- v0.4 wrappers: ticket keys, run folders, run marker, browser, prune ----------
KEY_RE = re.compile(r"[A-Z][A-Z0-9]+-\d+", re.ASCII)  # ASCII: Jira keys never hold other digits


class BadInput(ValueError):
    """Bad command-line input: printed to stderr, exit 2."""


class BadOption(BadInput):
    """An unknown, repeated or empty --option: printed with the command's usage."""


def config():
    try:
        cfg = json.loads(CONFIG.read_text())
        return cfg if isinstance(cfg, dict) else {}
    except (OSError, ValueError):
        return {}


def expand_keys(args, prefix=None):
    """['1234', 'ops-7,1250'] -> ['STUDIO-1234', 'OPS-7', 'STUDIO-1250'] (prefix from config jiraKeyPrefix)."""
    prefix = str(prefix or "").strip().rstrip("-")
    prefix = prefix.upper() if prefix.isascii() else prefix
    out = []
    for tok in (t for a in args for t in re.split(r"[,\s]+", a) if t):
        if tok.isascii() and tok.isdigit():
            if not prefix:
                raise BadInput(f"set jiraKeyPrefix in {CONFIG} (e.g. \"STUDIO\") to use bare numbers like {tok}, "
                               "or give full keys")
            if not re.fullmatch(r"[A-Z][A-Z0-9]+", prefix, re.ASCII):
                raise BadInput(f"jiraKeyPrefix in {CONFIG} must be a Jira project key like \"STUDIO\" (got "
                               f"{short(prefix, 40)!r}); fix it, or give full keys")
            key = f"{prefix}-{tok}"
        else:
            key = tok.upper() if tok.isascii() else tok  # "ß-12".upper() is "SS-12": non-ASCII must fail, not morph
        if not KEY_RE.fullmatch(key):
            raise BadInput(f"not a ticket number or key: {tok!r} (use 1234 or STUDIO-1234)")
        if key not in out:
            out.append(key)
    if not out:
        raise BadInput("give ticket numbers or keys, e.g. 1234 1250 or STUDIO-1234")
    return out


def route_slug(route):
    """C3 slug: '/form.html' -> form, '/incidents/4521' -> incidents-id, '/#/zones' -> zones, '/' -> home."""
    r = norm_route(route)
    path, _, frag = r.partition("#")
    segs = [x for x in (path + "/" + frag.lstrip("!")).split("/") if x]
    if segs and "." in segs[-1]:
        segs[-1] = segs[-1].rsplit(".", 1)[0] or segs[-1]  # '/.well-known' keeps its name
    segs = ["id" if x == ":id" else x for x in segs if x]
    return re.sub(r"[^A-Za-z0-9._-]+", "-", "-".join(segs)).strip("-") or "home"


def run_label(keys=None, route=None, label=None, prefix=""):
    if keys:
        text = "+".join(keys[:3]) + (f"+{len(keys) - 3}more" if len(keys) > 3 else "")
    elif route is not None:
        text = route_slug(route)
    else:
        text = str(label or "").strip() or "run"
    # capped: a folder name over 255 bytes can't be created (a long qa-plan text label or route)
    return re.sub(r"[^A-Za-z0-9+._-]", "-", f"{prefix or ''}{text}")[:80]


def git_exclude(project, entries=("qa-out/", ".playwright-cli/", ".playwright-mcp/")):
    """Keep run output out of commits: list it in the repo's info/exclude (works in worktrees and submodules)."""
    out = _git(project, "rev-parse", "--git-path", "info/exclude")
    if not out or not out.strip():
        return
    path = Path(out.strip())
    path = path if path.is_absolute() else Path(project) / path
    try:  # bytes: a Latin-1 comment in someone's exclude file must not stop the run
        text = path.read_text(encoding="utf-8", errors="surrogateescape") if path.exists() else ""
    except OSError:
        return
    have = {x.strip().strip("/") for x in text.splitlines()}
    missing = [e for e in entries if e.strip("/") not in have]
    if missing:
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            with open(path, "a", encoding="utf-8") as fh:
                fh.write(("\n" if text and not text.endswith("\n") else "") + "".join(e + "\n" for e in missing))
        except OSError:
            pass  # an unwritable .git: the run still works, the output just isn't git-ignored


def _project(project):
    """The project folder, or BadInput (a typo must not create a stray folder or report a silent no-op)."""
    project = Path(project).resolve()
    if not project.is_dir():
        raise BadInput(f"not a folder: {project}")
    return project


def make_rundir(project, label, day=None):
    """<project>/qa-out/<YYYY-MM-DD>-<label>[-n]/ with bugs/ evidence/ repro/ .data/; a fresh folder every run."""
    project = _project(project)
    root = project / "qa-out"
    root.mkdir(exist_ok=True)
    base = f"{day or datetime.now().strftime('%Y-%m-%d')}-{label}"
    for n in range(1, 1000):
        run = root / (base if n == 1 else f"{base}-{n}")
        try:
            run.mkdir(mode=0o700)
            break
        except FileExistsError:
            continue
    else:
        raise BadInput(f"too many run folders named {base}")
    for sub in ("bugs", "evidence", "repro", ".data"):
        (run / sub).mkdir()
    git_exclude(project)
    return run


MARKER_HOURS = 8  # the guard ignores a marker after this (a crashed run); also caps --minutes


def marker_start(project, budget=0, minutes=0, faults=False, t=None):
    """qa-out/.active for the guard: 0 = unlimited budget / no deadline. Written atomically."""
    t = time.time() if t is None else t
    root = _project(project) / "qa-out"
    root.mkdir(exist_ok=True)
    data = {"expires": int(t + MARKER_HOURS * 3600), "deadline": int(t + minutes * 60) if minutes else 0,
            "budget": int(budget or 0), "faults": bool(faults), "used": 0}
    _write(root / ".active", json.dumps(data) + "\n")
    return data


def marker_stop(project):
    for name in (".active", ".active.lock"):
        (Path(project) / "qa-out" / name).unlink(missing_ok=True)


def profile_dir():
    """The persistent `main` browser profile (the QA sign-in lives here; the guard protects it)."""
    return DATA_DIR / "profiles" / "main"


def signed_in_stamp():
    """Written by `qa-mem login-ok` after qa-login verified the sign-in; removed when a new qa-login starts."""
    return DATA_DIR / "profiles" / ".signed-in"


def ensure_profile_dir():
    p = profile_dir()
    DATA_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    for d in (p.parent, p):
        d.mkdir(mode=0o700, exist_ok=True)
        os.chmod(d, 0o700)
    return p


def browser_cmd(session, headed, url, browser, profile):
    cmd = ["playwright-cli", f"-s={session}", "open", f"--browser={browser}", "--profile", str(profile)]
    return cmd + (["--headed"] if headed else []) + ([url] if url else [])


def browser_open(args):
    session, headed, url = "qa", False, None
    it = iter(args)
    for a in it:
        if a == "--headed":
            headed = True
        elif a == "--session" or a.startswith("--session="):
            session = a.split("=", 1)[1] if "=" in a else next(it, "")
        elif a.startswith("-") or url:
            raise BadOption(f"browser-open: unexpected argument {a!r}")
        else:
            url = a
    if session not in ("qa", "qa-login"):
        raise BadInput("browser-open: --session must be qa or qa-login")
    browser = config().get("browser")
    if browser not in BROWSERS:
        try:
            json.loads(CONFIG.read_text())
            where = f'set "browser" in {CONFIG}'
        except OSError:
            where = f'{CONFIG} is missing; create it with a "browser" key'
        except ValueError as e:
            where = f"{CONFIG} isn't valid JSON ({e}); fix it"
        raise BadInput(f"browser-open: config browser must be one of {', '.join(BROWSERS)} (got {browser!r}): "
                       f"{where} (`qa-mem browsers` lists what's installed)")
    # every PLAYWRIGHT_MCP_* var (storage state, isolated, browser, user data dir…) would override the profile or break the launch
    env = {k: v for k, v in os.environ.items() if not k.startswith(("PLAYWRIGHT_MCP_", "PWTEST_"))}
    profile = ensure_profile_dir()
    if session == "qa-login":  # a new sign-in starts: until it is verified (login-ok), doctor says to sign in
        signed_in_stamp().unlink(missing_ok=True)
    other = "qa-login" if session == "qa" else "qa"
    try:  # both sessions use profiles/main, which opens in one browser only: stop the other one (no-op if it's closed)
        subprocess.run(["playwright-cli", f"-s={other}", "close"], env=env, capture_output=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        pass  # the open below reports a missing playwright-cli or a profile still in use
    try:  # captured (the daemon gets its own stdio, so this returns) to translate the profile-in-use error
        r = subprocess.run(browser_cmd(session, headed, url, browser, profile), env=env, capture_output=True, text=True,
                           errors="replace")
    except OSError as e:
        raise BadInput(f"browser-open: can't run playwright-cli ({e}); npm i -g @playwright/cli")
    code_ = r.returncode if r.returncode >= 0 else 128 - r.returncode  # killed by signal N: exit 128+N like a shell
    if "already in use" in f"{r.stdout}\n{r.stderr}":
        # playwright-cli's hint (--isolated) would drop the sign-in; say what actually holds the profile
        print(f"browser-open: Browser is already in use: another qa-sdet browser holds the main profile (a "
              f"/qa-sdet:qa-login window not finished, or a run in another project folder). Close the other qa-sdet "
              f"browser (or run `playwright-cli close-all` in that folder) and retry; never use --isolated, it has no "
              f"login.", file=sys.stderr)
        code_ = code_ or 1
    sys.stdout.write(r.stdout or "")
    sys.stderr.write(r.stderr or "")
    return code_


def prune(project, days=7, t=None):
    """Delete page snapshots older than `days` (regular files only; links are never followed). Returns the count."""
    cutoff, n = (time.time() if t is None else t) - days * 86400, 0
    for name in (".playwright-cli", ".playwright-mcp"):
        top = Path(project) / name
        if top.is_symlink() or not top.is_dir():
            continue
        for dirpath, _, files in os.walk(top):
            for fn in files:
                f = Path(dirpath) / fn
                try:
                    st = f.lstat()
                    if stat.S_ISREG(st.st_mode) and st.st_mtime < cutoff:
                        f.unlink()
                        n += 1
                except OSError:
                    continue
    return n


# ---------- annotated bug images ----------
RED, WHITE = (224, 0, 0), (255, 255, 255)
NO_PILLOW = "annotate: Pillow not installed (python3 -m pip install --user pillow); image left as is"


def evidence_png(path):
    """The real path of a .png inside qa-out/<run>/evidence/, or BadInput. The project is the folder holding the
    qa-out named in the path; the png's real path must stay inside that project (a link to another project's
    evidence, or a qa-out/<run> linked elsewhere, is refused)."""
    shape = lambda q: q.suffix.lower() == ".png" and q.parent.name == "evidence" and q.parent.parent.parent.name == "qa-out"
    given = Path(os.path.abspath(os.path.expanduser(str(path))))  # lexical: links not followed yet
    p = Path(os.path.realpath(given))
    project = Path(os.path.realpath(given.parents[3])) if len(given.parents) > 3 else None
    if not (shape(given) and shape(p) and project and p.is_relative_to(project)):
        raise BadInput(f"annotate: only .png files inside qa-out/<run>/evidence/ of this project ({path})")
    if not p.is_file():
        raise BadInput(f"annotate: no such image {path}")
    return p


def parse_box(text):
    try:
        x, y, w, h = (int(round(float(v))) for v in text.split(","))
    except (ValueError, OverflowError):  # OverflowError: inf / 1e400
        raise BadInput(f"annotate: --box must be x,y,w,h (got {text!r})")
    if w <= 0 or h <= 0:
        raise BadInput(f"annotate: --box width and height must be > 0 ({text!r})")
    return x, y, w, h


def _font(ImageFont, size):
    try:
        return ImageFont.load_default(size=size)
    except TypeError:  # Pillow < 10.1: fixed-size bitmap font
        return ImageFont.load_default()


def _wrap(draw, text, font, width):
    """Lines of text no wider than width px (words kept whole unless one alone is too wide)."""
    lines, cur = [], ""
    for word in text.split(" "):
        while draw.textlength(word, font=font) > width and len(word) > 1:  # break an over-long word
            n = max(1, next((i for i in range(len(word), 0, -1) if draw.textlength(word[:i], font=font) <= width), 1))
            if cur:
                lines.append(cur)
                cur = ""
            lines.append(word[:n])
            word = word[n:]
        cand = f"{cur} {word}" if cur else word
        if cur and draw.textlength(cand, font=font) > width:
            lines.append(cur)
            cur = word
        else:
            cur = cand
    return lines + ([cur] if cur else [])


def annotate(path, boxes, label):
    """Red outline drawn just OUTSIDE each box (so the element's own text stays readable) and a red label tag
    with white text next to the first box, on the quietest nearby spot that covers no box (with no free spot, the one
    hiding the least of the boxes; a label taller than the image keeps the lines that fit, ending in …). Line width and font
    grow with the image (a HiDPI 2560px screenshot gets 2x), long labels wrap. Boxes are in the screenshot's
    pixels; a box wholly outside the image is refused. Returns False when Pillow is missing (image untouched)."""
    try:
        from PIL import Image, ImageDraw, ImageFont
    except ImportError:
        return False
    try:
        img = Image.open(path)
        img.load()
    except (OSError, Image.DecompressionBombError) as e:  # not a PNG, truncated, or too many pixels: left as is
        raise BadInput(f"annotate: can't read {path.name} as an image ({e}); image left as is")
    W, H = img.size
    for x, y, w, h in boxes:
        if x >= W or y >= H or x + w <= 0 or y + h <= 0:
            raise BadInput(f"annotate: --box {x},{y},{w},{h} is outside the {W}x{H} image; boxes are in the "
                           "screenshot's pixels (the box eval's numbers as is); image left as is")
    if img.mode.startswith("I"):  # 16/32-bit grey: convert("RGB") clips every value > 255 to white
        img = img.convert("I").point(lambda v: v / 256).convert("L")
    alpha = "A" in img.getbands() or "transparency" in img.info  # palette/grey PNGs keep transparency in info
    img = img.convert("RGBA" if alpha else "RGB")
    grey = img.convert("L")  # the page before drawing: where the label would hide the least
    scale = min(max(W / 1280, 1.0), 4.0)
    lw, gap = max(2, round(3 * scale)), max(2, round(3 * scale))
    draw = ImageDraw.Draw(img)
    drawn = []
    for x, y, w, h in boxes:  # four bands just outside the element, each clipped to the image: at an image edge
        bx0, by0, bx1, by1 = x, y, x + w - 1, y + h - 1  # the band there is thinner, never moved onto the element
        ox0, oy0, ox1, oy1 = bx0 - lw, by0 - lw, bx1 + lw, by1 + lw
        for r in ((ox0, oy0, ox1, by0 - 1), (ox0, by1 + 1, ox1, oy1), (ox0, by0, bx0 - 1, by1), (bx1 + 1, by0, ox1, by1)):
            cx0, cy0, cx1, cy1 = max(r[0], 0), max(r[1], 0), min(r[2], W - 1), min(r[3], H - 1)
            if cx0 <= cx1 and cy0 <= cy1:
                draw.rectangle([cx0, cy0, cx1, cy1], fill=RED)
        drawn.append((max(ox0, 0), max(oy0, 0), min(ox1, W - 1), min(oy1, H - 1)))
    text = short(" ".join(str(label).split()), 80)
    if text:
        font, pad = _font(ImageFont, round(18 * scale)), max(4, round(4 * scale))
        lines = _wrap(draw, text, font, max(1, W - 2 * pad))
        asc, desc = font.getmetrics() if hasattr(font, "getmetrics") else (11, 0)
        lh = asc + desc + max(1, round(2 * scale))
        room = max(1, (H - 2 * pad) // lh)  # a short screenshot: keep the lines that fit, say the rest was cut
        if len(lines) > room:
            lines = lines[:room]
            while len(lines[-1]) > 1 and draw.textlength(lines[-1] + "…", font=font) > W - 2 * pad:
                lines[-1] = lines[-1][:-1]
            lines[-1] = lines[-1].rstrip() + "…"
        tw = min(max(round(draw.textlength(t, font=font)) for t in lines) + 2 * pad, W)
        th = min(lh * len(lines) + 2 * pad, H)
        x0, y0, x1, y1 = drawn[0]
        ux0, uy0, uy1 = min(c[0] for c in drawn), min(c[1] for c in drawn), max(c[3] for c in drawn)
        fit = lambda tx, ty: (max(0, min(tx, W - tw)), max(0, min(ty, H - th)))
        hits = lambda tx, ty: any(tx < c[2] + gap and c[0] - gap < tx + tw and ty < c[3] + gap and c[1] - gap < ty + th
                                  for c in drawn)

        def busy(tx, ty):  # share of pixels that are page content (differ from the spot's commonest shade)
            hist = grey.crop((tx, ty, tx + tw, ty + th)).histogram()
            bg = max(range(256), key=hist.__getitem__)
            return 1 - sum(hist[max(0, bg - 24):bg + 25]) / max(1, sum(hist))
        # around the first box (above, below, right, left; then above/below its right end), then above/below all
        spots = [fit(x0, y0 - th - gap), fit(x0, y1 + gap + 1), fit(x1 + gap + 1, y0), fit(x0 - gap - tw, y0),
                 fit(x1 - tw, y0 - th - gap), fit(x1 - tw, y1 + gap + 1), fit(ux0, uy0 - th - gap), fit(ux0, uy1 + gap + 1),
                 fit(0, 0), fit(W, 0), fit(0, H), fit(W, H)]  # corners: the last resort when nothing near is free
        cover = lambda tx, ty: sum(max(0, min(tx + tw, c[2] + 1) - max(tx, c[0])) * max(0, min(ty + th, c[3] + 1) - max(ty, c[1]))
                                   for c in drawn)  # box area hidden (no free spot: hide the least)
        free = [xy for xy in spots if not hits(*xy)]
        quiet = [xy for xy in free if busy(*xy) < 0.01]
        tx, ty = (quiet[0] if quiet else min(free, key=lambda xy: busy(*xy)) if free
                  else min(spots, key=lambda xy: (cover(*xy), busy(*xy))))
        draw.rectangle([tx, ty, tx + tw - 1, ty + th - 1], fill=RED)
        for i, t in enumerate(lines):
            draw.text((tx + pad, ty + pad + i * lh), t, fill=WHITE, font=font)
    # a fresh temp file (O_EXCL): a planted .tmp symlink must not redirect the write outside evidence/
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as f:
            img.save(f, format="PNG")
        os.chmod(tmp, stat.S_IMODE(path.stat().st_mode))
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise
    return True


# ---------- REPORT.md: one human report per run folder, rendered from .data/plan.json + .data/run-*.json ----------
STATUS_ICON = {"PASS": "✅ PASS", "FAIL": "❌ FAIL", "BLOCKED": "⛔ BLOCKED", "NOT_RUN": "⏸️ not run",
               "QUESTION": "❓ QUESTION"}
STATUS_RANK = ("FAIL", "BLOCKED", "QUESTION", "NOT_RUN", "PASS")  # worst first
VERDICT_ICON = {"FAIL": "❌ FAIL", "BLOCKED": "⛔ BLOCKED", "PASS WITH NOTES": "⚠️ PASS WITH NOTES", "PASS": "✅ PASS",
                "NOT STARTED": "⏳ NOT STARTED"}
COVERAGE_ICON = {"pass": "✅", "fail": "❌", "blocked": "⛔"}


def _load_json(path, warnings):
    try:
        return redact_json(json.loads(Path(path).read_text()))
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        warnings.append(f"{Path(path).name} unreadable ({type(e).__name__})")
        return None


def load_run(run_dir):
    """{'plan': {...}, 'runs': [(file name, run dict)], 'warnings': [...]}; missing pieces are simply absent."""
    data, warnings = Path(run_dir) / ".data", []
    plan = _load_json(data / "plan.json", warnings)
    if plan is not None and not isinstance(plan, dict):
        warnings.append("plan.json is not an object")
        plan = None
    runs = []
    for f in sorted(data.glob("run-*.json"), key=lambda x: (x.stat().st_mtime, x.name)):
        r = _load_json(f, warnings)
        if isinstance(r, dict):
            runs.append((f.name, r))
            for key in ("cases", "bugs", "pages", "questions", "not_tested"):  # dropped below: say so, don't hide it
                if r.get(key) is not None and not isinstance(r[key], list):
                    warnings.append(f"{f.name}: `{key}` should be a list (got {type(r[key]).__name__}); "
                                    f"its entries are not in this report")
        elif r is not None:
            warnings.append(f"{f.name} is not an object")
    return {"plan": plan or {}, "runs": runs, "warnings": warnings}


def _list(obj, key):
    v = obj.get(key) if isinstance(obj, dict) else None
    return [x for x in v if isinstance(x, dict)] if isinstance(v, list) else []


def _strs(obj, key):
    v = obj.get(key) if isinstance(obj, dict) else None
    return [str(x) for x in v if isinstance(x, (str, int, float))] if isinstance(v, list) else []


def bug_id(b):
    for f in ("draft_path", "evidence"):
        m = re.search(r"(BUG-\d+)\.\w+$", str(b.get(f) or ""))
        if m:
            return m.group(1)
    return ""


MERGE_RANK = ("NOT_RUN", "BLOCKED", "PASS", "QUESTION", "FAIL")  # weakest first: what a run actually saw beats a skip


def merged_cases(plan, runs, warnings=None):
    """Plan cases with their result from the run JSONs (missing -> NOT_RUN); cases only a run knows are appended.
    Each gets status, actual, notes, bug. When several runs report one case, the most decisive result wins (FAIL over
    QUESTION over PASS over BLOCKED over NOT_RUN; the newest run on a tie), so another route listing a case as
    "not run" never hides its FAIL. A plan case with no id or a repeated one can't get a result: it is left out and
    named in `warnings`."""
    warnings = [] if warnings is None else warnings
    results = {}
    rank = lambda c: MERGE_RANK.index(case_status(c.get("status")) or "NOT_RUN")
    for _, r in runs:
        for c in _list(r, "cases"):
            if isinstance(c.get("id"), (str, int)) and c["id"] != "":
                cid = str(c["id"])
                if cid not in results or rank(c) >= rank(results[cid]):
                    results[cid] = c
    out, seen = [], set()
    for c in _list(plan, "cases") + [c for c in results.values() if str(c["id"]) not in
                                       {str(p.get("id")) for p in _list(plan, "cases")}]:
        cid = str(c["id"]) if c.get("id") not in (None, "") else ""  # a numeric id 0 is still an id
        if not cid or cid in seen:
            what = one_line(short(c.get("title") or c.get("expected") or "untitled", 60))
            warnings.append(f"plan.json: case '{what}' " + (f"repeats id {cid}" if cid else "has no id")
                            + "; it is left out of this report: give it an id of its own (e.g. TC-99)")
            continue
        seen.add(cid)
        res = results.get(cid, {})
        ac = c.get("ac")  # a case may cover several AC: "AC-1, AC-2" or a list
        ac = ", ".join(str(a) for a in ac if isinstance(a, (str, int))) if isinstance(ac, list) else ac
        out.append({**c, "id": cid, "ac": ac, "status": case_status(res.get("status")) or "NOT_RUN",
                    "actual": str(res.get("actual") or ""), "notes": str(res.get("notes") or ""),
                    "bug": str(res.get("bug") or "")})
    return out


def run_bugs(runs):
    """Every bug of every run, once, with id (BUG-n from its draft) and route."""
    out, seen = [], set()
    for _, r in runs:
        route = norm_route(r.get("target")) if str(r.get("target") or "").startswith(("/", "http", "#")) else ""
        for b in _list(r, "bugs"):
            b = {**b, "id": bug_id(b), "route": norm_route(b.get("route")) or route, "target": route}
            key = b["id"] or (b["route"], norm(b.get("title")))
            if key not in seen:
                seen.add(key)
                out.append(b)
    return out


def _case_bugs(c):
    """Bugs a case names in `bug`: BUG-n ids and known bugs' 12-char hashes ("BUG-2", "BUG-2, 3f9a…", "see BUG-2")."""
    t = str(c.get("bug") or "")
    return set(re.findall(r"BUG-\d+", t)) | {h.lower() for h in re.findall(r"\b[0-9a-fA-F]{12}\b", t)}


def _bug_refs(b):
    """What a case may call this bug by: its BUG-n id and, for a known bug, its hash."""
    return {x for x in (str(b.get("id") or ""), str(b.get("hash") or "")[:12].lower()) if x}


def ticket_bugs(key, cases, bugs, known=()):
    """Bugs that belong to one ticket: tagged with it, referenced by one of its cases, or untagged on one of its routes
    (unless a case of another ticket names it: then it is that ticket's bug, not every ticket's on a shared page)."""
    mine = [c for c in cases if c.get("ticket") == key]
    refs = set().union(*map(_case_bugs, mine))
    named = set().union(*map(_case_bugs, cases))
    routes = {norm_route(c.get("route")) for c in mine if c.get("route")}
    tickets = {str(c.get("ticket")).strip().upper() for c in cases if c.get("ticket")} | {str(k).strip().upper() for k in known}
    tag = lambda b: str(b.get("ticket") or "").strip().upper()  # 's-1 ' is S-1; 'none' or an unknown key is no tag
    # untagged: on one of the ticket's routes, or found by the run of one (a record page opened from its list page)
    return [b for b in bugs if tag(b) == str(key).strip().upper() or (_bug_refs(b) & refs)
            or (tag(b) not in tickets and (b.get("route") in routes or b.get("target") in routes)
                and not (_bug_refs(b) & named))]


def _serious(b):
    return str(b.get("classification") or "").upper() == "CONFIRMED" and \
        str(b.get("severity") or "").upper() in ("CRITICAL", "HIGH")


def _bug_word(b):
    sev = str(b.get("severity") or "").upper() or "unrated"
    extra = "" if str(b.get("classification") or "").upper() in ("CONFIRMED", "") else \
        f" {str(b['classification']).lower()}"
    name = b.get("id") or ("known bug " if b.get("hash") else "") + short(b.get("title"), 40)  # known: re-sighted
    return f"{name} {sev}{extra}"


def _some(parts, n=3):
    return "; ".join(parts[:n]) + (f"; +{len(parts) - n} more" if len(parts) > n else "")


def _clip(s, n):
    """short() cut back to the last word so a number or name is never cut in half."""
    s = " ".join(str(s or "").split())
    if len(s) <= n:
        return s
    cut = s[:n - 1]
    return (cut[:cut.rfind(" ")] if " " in cut[n // 2:] else cut).rstrip(" ,;:") + "…"


def _ac_id(ac):
    """An AC's id as text ('' when missing or not a string or number: a list there must not break the report)."""
    return str(ac["id"]).strip() if isinstance(ac.get("id"), (str, int)) and not isinstance(ac["id"], bool) else ""


def _case_acs(c):
    """The AC ids a case covers: "AC-1" or "AC-1, AC-2"."""
    return {a.strip() for a in re.split(r"[,;]", str(c.get("ac") or "")) if a.strip()}


def verdict(ticket, cases, bugs, started=True, known=()):
    """(verdict, reason) for one ticket: FAIL, BLOCKED, PASS WITH NOTES or PASS (rules in references/report.md);
    NOT STARTED while no test run has reported yet."""
    if not started:
        return "NOT STARTED", "testing hasn't started yet"
    key = ticket.get("key") if isinstance(ticket, dict) else ticket
    mine = [c for c in cases if c.get("ticket") == key]
    its_bugs = ticket_bugs(key, cases, bugs, known)
    st = lambda c: c.get("status") or "NOT_RUN"
    why = lambda c: f": {_clip(c.get('actual') or c.get('notes'), 60)}" if c.get("notes") or c.get("actual") else \
        f": no result reported for {norm_route(c['route'])}" if st(c) == "NOT_RUN" and c.get("route") else ""
    fails = [c for c in mine if st(c) == "FAIL"]
    if len(fails) == 1:  # one failure: say what happened (cut at a word, never mid-number: "at 1…" for 131)
        c = fails[0]
        failed = [f"{c['id']} failed" + (f" ({c['ac']})" if c.get("ac") else "") +
                  (f": {_clip(c.get('actual') or c.get('notes'), 50)}" if c.get("actual") or c.get("notes") else "")]
    else:  # several: one entry naming them all; each case's actual is in the case table
        acs = sorted({a for c in fails for a in _case_acs(c)}, key=lambda a: [int(x) if x.isdigit() else x
                                                                             for x in re.split(r"(\d+)", a)])
        ids = [c["id"] for c in fails]
        failed = [f"{len(ids)} cases failed ({', '.join(ids[:6])}{f', +{len(ids) - 6}' if len(ids) > 6 else ''})"
                  + (f" on {', '.join(acs)}" if acs else "")] if fails else []
    serious = [_bug_word(b) for b in its_bugs if _serious(b)]
    if failed or serious:
        return "FAIL", _some(failed + serious)
    if not mine:
        return "BLOCKED", "no test cases"
    stuck = {}  # same reason → one entry naming all its cases, so 12 blocked cases don't repeat one error 12 times
    for c in mine:
        if st(c) in ("BLOCKED", "NOT_RUN"):
            stuck.setdefault(f"{'blocked' if st(c) == 'BLOCKED' else 'not run'}{why(c)}", []).append(c["id"])
    if stuck:
        return "BLOCKED", _some([(f"{ids[0]}" if len(ids) == 1 else f"{len(ids)} cases ({ids[0]}–{ids[-1]})") + f" {r}"
                                 for r, ids in stuck.items()], 2)
    covered = {a for c in mine for a in _case_acs(c)}
    notes = [f"{c['id']} open question" for c in mine if st(c) == "QUESTION"] + \
            [_bug_word(b) for b in its_bugs] + \
            [f"{_ac_id(a)} has no test case" for a in _list(ticket, "acs") if _ac_id(a) and _ac_id(a) not in covered]
    if notes:
        return "PASS WITH NOTES", _some(notes)
    return "PASS", f"all {len(mine)} cases passed"


def cell(v):
    """Text for one table cell or line: `|` escaped, newlines as <br>, and no raw HTML, images or links (an XSS payload,
    `<!--` or `[text](https://…)` typed into a form must show as text, not hide the report or become a hidden-URL link;
    breaking `](` and `]:` stops inline links, images and reference definitions while `[BLOCKING]` stays readable)."""
    return str(v if v is not None else "").replace("\\", "\\\\").replace("|", "\\|").replace("\r", "") \
        .replace("<", "&lt;").replace("](", "]\\(").replace("]:", "]\\:").strip().replace("\n", "<br>")


class Raw(str):
    """Already Markdown (a link): row() puts it in as is."""


def one_line(v):
    """Text for a heading or list line: whitespace and newlines collapsed, `|` escaped."""
    return cell(" ".join(str(v if v is not None else "").split()))


def row(*cols):
    return "| " + " | ".join(c if isinstance(c, Raw) else cell(c) for c in cols) + " |"


def _counts(cases):
    p = sum(c["status"] == "PASS" for c in cases)
    f = sum(c["status"] == "FAIL" for c in cases)
    return f"{p} / {f} / {len(cases) - p - f}"


def _bug_link(bid, run_dir):
    """A link to bugs/BUG-n.md when bid is exactly BUG-n and the draft exists; anything else as escaped text."""
    bid = str(bid or "")
    if re.fullmatch(r"BUG-\d+", bid) and (Path(run_dir) / "bugs" / f"{bid}.md").exists():
        return f"[{bid}](bugs/{bid}.md)"
    return one_line(bid)


def _ticket_title(t):
    return " ".join(str(f"{t.get('key')} — {t['summary']}" if t.get("summary") else t.get("key")).split())


def _ac_lines(t, cases, with_status):
    out = []
    for ac in _list(t, "acs"):
        mine = [c for c in cases if _ac_id(ac) in _case_acs(c)]
        ids = f" ({one_line(', '.join(c['id'] for c in mine))})" if mine else ""
        if not mine:
            state = " — not covered"
        elif with_status:
            state = " — " + STATUS_ICON[next(s for s in STATUS_RANK if any(c["status"] == s for c in mine))]
        else:
            state = ""
        out.append(f"- {one_line(_ac_id(ac))} {cell(ac.get('text'))}{state}{ids}".replace("  ", " "))
    return out


def _plan_lines(t):
    plan, out = t.get("plan") if isinstance(t.get("plan"), dict) else {}, []
    for key, label in (("scope", "Scope"), ("approach", "Approach"), ("risks", "Risks"),
                       ("out_of_scope", "Out of scope"), ("test_data", "Test data")):
        v = plan.get(key)
        if isinstance(v, list) and v:
            out.append(f"- **{label}:**")
            out += [f"  - {cell(x)}" for x in v]
        elif v and not isinstance(v, (list, dict)):
            out.append(f"- **{label}:** {cell(v)}")
    return out


def _case_table(cases, run_dir, with_status):
    # priority (P1 first) when the plan set one; the start page when the cases start on more than one
    pri = any(c.get("priority") for c in cases)
    routes = len({str(c.get("route")).strip() for c in cases if c.get("route")}) > 1
    head = ["ID"] + ["Pri"] * pri + ["AC"] + ["Page"] * routes + ["Case", "Steps", "Expected"] + \
        (["Status", "Actual / notes"] if with_status else [])
    out = [row(*head), "|" + "---|" * len(head)]
    for c in cases:
        steps = c.get("steps")
        steps = "\n".join(f"{i}. {s}" for i, s in enumerate(steps, 1)) if isinstance(steps, list) else steps
        cols = [c["id"]] + [c.get("priority")] * pri + [c.get("ac")] + [c.get("route")] * routes + \
            [c.get("title"), steps, c.get("expected")]
        if with_status:
            note = " — ".join(x for x in (short(c["actual"], 300), short(c["notes"], 300)) if x)
            cols += [STATUS_ICON[c["status"]], note]
        line = row(*cols)
        if with_status and c.get("bug"):  # the link must not be escaped
            line = line[:-2] + (" " if note else "") + _bug_link(c["bug"], run_dir) + " |"
        out.append(line)
    return out


def _header(run_dir, kind, plan, runs):
    env = plan.get("env") if isinstance(plan.get("env"), dict) else {}
    renvs = [r["env"] for _, r in runs if isinstance(r.get("env"), dict)]
    renv = renvs[0] if renvs else {}
    # plan.json is written before C0 picks the browser: what the runs used (e.g. the MCP fallback) wins
    used = sorted({str(e["browser"]) for e in renvs if e.get("browser")})
    m = re.match(r"\d{4}-\d{2}-\d{2}", Path(run_dir).name)
    date = str(plan.get("created") or "")[:10] or (m.group(0) if m else "")
    builds = sorted({str(r.get("build")) for _, r in runs if r.get("build")})
    bits = [kind, date, str(env.get("url") or renv.get("url") or ""),
            "build " + (", ".join(builds) if builds else "not run yet"),
            "browser " + (", ".join(used) or str(env.get("browser") or "?"))]
    return [f"# QA report: {one_line(plan.get('title') or Path(run_dir).name)}",
            " · ".join(one_line(b) for b in bits if b)]


def _bug_section(bugs, cases, tickets, run_dir):
    out = ["## Bugs", row("Bug", "Severity", "Class", "Title", "Page", "Ticket", "Evidence"), "|---|---|---|---|---|---|---|"]
    for b in bugs:
        bid = b.get("id") or ""
        owners = [str(b["ticket"])] if b.get("ticket") else [str(t) for t in tickets if b in ticket_bugs(t, cases, [b], tickets)]
        png = Path(run_dir) / "evidence" / f"{bid}.png"
        ev = Path(str(b.get("evidence") or ""))
        img = f"evidence/{quote(png.name)}" if bid and png.exists() else \
            f"evidence/{quote(ev.name)}" if b.get("evidence") and (Path(run_dir) / "evidence" / ev.name).exists() else ""
        evidence = f"[image]({img})" + (" (not highlighted)" if b.get("annotated") is False else "") if img else "—"
        link = _bug_link(bid, run_dir) or (one_line(f"known {str(b.get('hash'))[:12]}") if b.get("hash") else "—")
        out.append(row(Raw(link), b.get("severity"), b.get("classification"), short(b.get("title"), 120), b.get("route"),
                       ", ".join(owners), Raw(evidence)))
    return out


def _notes_section(runs):
    out = ["## Exploration notes", "Heuristics: ✅ checked, no problem · ❌ problem found · ⛔ could not be checked", ""]
    for name, r in runs:
        route = r.get("target") or next((p.get("route") for p in _list(r, "pages")), "") or name
        out.append("### " + one_line(f"{route} ({name}: {r.get('status') or '?'}, build {r.get('build') or '?'})"))
        if r.get("notes") or r.get("summary"):
            para = cell(short(r.get("notes") or r.get("summary"), 1500))  # a leading ``` would fence off the rest
            out += [("\\" if para[:1] in tuple("#`~>-+*=_") else "") + para, ""]
        cov = {}
        for p in _list(r, "pages"):
            for c in _list(p, "coverage"):
                if c.get("heuristic"):
                    h, res = heuristic_id(c["heuristic"]), coverage_result(c.get("result"))
                    order = ("fail", "blocked", "pass")
                    if h not in cov or (res in order and (cov[h] not in order or order.index(res) < order.index(cov[h]))):
                        cov[h] = res
        if cov:
            out.append("Heuristics covered: " + ", ".join(one_line(f"{h} {COVERAGE_ICON.get(v, v)}") for h, v in cov.items()))
        out.append("")
    return out


def render_report(run_dir):
    d = load_run(run_dir)
    plan, runs = d["plan"], d["runs"]
    kind = str(plan.get("kind") or (runs[0][1].get("mode") if runs else "") or "explore")
    tickets = [t for t in _list(plan, "tickets") if t.get("key")]
    keys = [t["key"] for t in tickets]
    cases, bugs = merged_cases(plan, runs, d["warnings"]), run_bugs(runs)
    with_status = kind != "plan"
    out = _header(run_dir, kind, plan, runs) + [""]
    if not plan and not runs:
        out += ["_Nothing recorded yet: no plan and no test run in this folder._", ""]
    if tickets and kind == "plan":
        out += ["## Summary", row("Ticket", "ACs", "Cases"), "|---|---|---|"]
        out += [row(_ticket_title(t), len(_list(t, "acs")), sum(c.get("ticket") == t["key"] for c in cases))
                for t in tickets]
    elif tickets:
        out += ["## Summary", row("Ticket", "Verdict", "Why", "Cases (pass/fail/other)", "Bugs"), "|---|---|---|---|---|"]
        for t in tickets:
            v, why = verdict(t, cases, bugs, bool(runs), keys)
            mine = [c for c in cases if c.get("ticket") == t["key"]]
            out.append(row(_ticket_title(t), VERDICT_ICON[v], why, _counts(mine), len(ticket_bugs(t["key"], cases, bugs, keys))))
    elif runs:
        out += ["## Summary", "**Status:** " + "; ".join(
            one_line(f"{r.get('target') or name} {r.get('status') or '?'}") for name, r in runs)
            + f" · {len(bugs)} bug(s)" + (f" · cases {_counts(cases)} (pass/fail/other)" if cases else "")]
    out.append("")
    for t in tickets:
        mine = [c for c in cases if c.get("ticket") == t["key"]]
        out.append(f"## {one_line(_ticket_title(t))}")
        if with_status:
            v, why = verdict(t, cases, bugs, bool(runs), keys)
            out.append(f"**Verdict: {VERDICT_ICON[v]}** — {one_line(why)}")
        if _list(t, "acs"):
            out += ["### Acceptance criteria"] + _ac_lines(t, mine, with_status)
        if _plan_lines(t):
            out += ["### Test plan"] + _plan_lines(t)
        if mine:
            out += ["### Test cases"] + _case_table(mine, run_dir, with_status)
        out.append("")
    other = [c for c in cases if c.get("ticket") not in keys]
    if other:
        out += ["## Test cases" if not tickets else "## Other test cases"] + _case_table(other, run_dir, with_status) + [""]
    if runs:
        out += (_bug_section(bugs, cases, keys, run_dir) if bugs else ["## Bugs", "None found."]) + [""]
    asked = _strs(plan, "questions")
    many = sum(bool(_strs(r, "questions")) for _, r in runs) > 1  # several pages raised some: say which
    raised = [(f"{r.get('target') or name}: " if many else "") + q for name, r in runs for q in _strs(r, "questions")] + \
        [f"{c['id']}: {c['notes'] or c['actual'] or c.get('title') or ''}" for c in cases if c["status"] == "QUESTION"]
    bullets = lambda qs: [f"- {cell(short(q, 300))}" for q in qs]
    if asked and raised:  # two lists, so a follow-up on plan Q1 doesn't read as a second, unnumbered Q1
        out += ["## Questions", "**From the test plan (before testing):**", ""] + bullets(asked) + \
            ["", "**Raised while testing:**", ""] + bullets(raised) + [""]
    elif asked or raised:
        out += ["## Questions"] + bullets(asked or raised) + [""]
    not_tested = [q for _, r in runs for q in _strs(r, "not_tested")]
    if not_tested:
        out += ["## Not tested"] + [f"- {cell(short(q, 300))}" for q in not_tested] + [""]
    if runs:
        out += _notes_section(runs)
    if d["warnings"]:
        out += ["## Problems reading this folder"] + [f"- {one_line(w)}" for w in d["warnings"]] + [""]
    return "\n".join(out).rstrip() + "\n"


def run_summary(run_dir):
    """(date, kind, verdict text, bug count) for the qa-out/README.md index."""
    d = load_run(run_dir)
    plan, runs = d["plan"], d["runs"]
    kind = str(plan.get("kind") or (runs[0][1].get("mode") if runs else "") or "explore")
    cases, bugs = merged_cases(plan, runs), run_bugs(runs)
    tickets = [t for t in _list(plan, "tickets") if t.get("key")]
    if kind == "plan":
        verdicts = f"plan only ({len(cases)} cases)"
    elif tickets:
        verdicts = ", ".join(f"{t['key']} {VERDICT_ICON[verdict(t, cases, bugs, bool(runs), [x['key'] for x in tickets])[0]]}" for t in tickets)
    else:
        verdicts = ", ".join(str(r.get("status") or "?") for _, r in runs) or "not run yet"
    m = re.match(r"\d{4}-\d{2}-\d{2}", Path(run_dir).name)
    return (m.group(0) if m else str(plan.get("created") or "")[:10]), kind, verdicts, len(bugs)


def render_index(qa_out):
    """qa-out/README.md: every run folder with a REPORT.md or a plan, newest first."""
    qa_out = Path(qa_out)
    runs = [p for p in qa_out.iterdir() if p.is_dir() and not p.is_symlink()
            and ((p / "REPORT.md").exists() or (p / ".data" / "plan.json").exists())]
    when = lambda p: max(x.stat().st_mtime for x in (p, p / "REPORT.md", p / ".data" / "plan.json") if x.exists())
    rows = []
    for p in runs:
        try:
            date, kind, verdicts, n = run_summary(p)
        except Exception as e:  # one odd folder must not break the index
            m = re.match(r"\d{4}-\d{2}-\d{2}", p.name)
            date, kind, verdicts, n = (m.group(0) if m else ""), "?", f"unreadable ({type(e).__name__})", "?"
        name = one_line(p.name).replace("[", "\\[").replace("]", "\\]")
        rows.append(((date, when(p)), row(date, Raw(f"[{name}]({quote(p.name, safe='+')}/REPORT.md)"), kind, verdicts, n)))
    rows.sort(key=lambda x: x[0], reverse=True)
    return "\n".join(["# QA runs", "Newest first. Open a run's REPORT.md for test cases, bugs and questions.", "",
                      row("Date", "Run", "Kind", "Verdict", "Bugs"), "|---|---|---|---|---|"] + [r for _, r in rows]) + "\n"


def _write(path, text):
    """Atomic write via a fresh temp file (O_EXCL): a planted `.<name>.tmp` link can't redirect it outside qa-out."""
    path = Path(path)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", errors="replace") as f:  # a lone surrogate in Jira or page text
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


def write_report(run_dir):
    run_dir = Path(run_dir).resolve()
    if not run_dir.is_dir() or run_dir.parent.name != "qa-out":
        raise BadInput(f"report: not a run folder (qa-out/<run>/): {run_dir}")
    try:
        text = render_report(run_dir)
    except Exception as e:  # never fail: say what went wrong in the report itself
        text = (f"# QA report: {one_line(run_dir.name)}\n\n_Could not render this report: {type(e).__name__}: "
                f"{one_line(short(e, 200))}. Check the files in .data/._\n")
    _write(run_dir / "REPORT.md", text)
    # Two reports at once (two sessions, or report + hook): without the lock the later index write could be one
    # rendered before the other run's REPORT.md existed, and that run would vanish from the index.
    fd = os.open(run_dir.parent, os.O_RDONLY) if fcntl else None  # the qa-out folder itself: no lock file left behind
    try:
        if fd is not None:
            fcntl.flock(fd, fcntl.LOCK_EX)
        _write(run_dir.parent / "README.md", render_index(run_dir.parent))
    finally:
        if fd is not None:
            os.close(fd)
    return run_dir / "REPORT.md"


# ---------- inbox: Jira tickets assigned to me, NEW ones flagged ----------
def _name(v):
    return str(v.get("name") or v.get("value") or "") if isinstance(v, dict) else str(v or "")


def inbox_items(data):
    """acli/Jira MCP search JSON (a list, or {issues|workItems|values: [...]}) -> [{key, summary, status, priority, updated}]."""
    if isinstance(data, dict):
        data = next((data[k] for k in ("issues", "workItems", "values") if isinstance(data.get(k), list)), None)
    if not isinstance(data, list):
        raise BadInput("inbox: expected a list of Jira items (or an object with issues / workItems / values)")
    out = []
    for it in data:
        if not isinstance(it, dict) or not KEY_RE.fullmatch(str(it.get("key") or "").upper()):
            continue
        f = it.get("fields") if isinstance(it.get("fields"), dict) else {}
        get = lambda k: f.get(k) if f.get(k) is not None else it.get(k)
        out.append({"key": str(it["key"]).upper(), "summary": short(" ".join(str(get("summary") or "").split()), 100),
                    "status": _name(get("status")), "priority": _name(get("priority")), "updated": str(get("updated") or "")})
    if data and not out:  # another JSON shape must not read as "no open tickets"
        raise BadInput(f"inbox: none of the {len(data)} items has a Jira key (\"key\": \"STUDIO-1234\"); ask the search for "
                       "the key field")
    return out


def inbox(con, project, data, prefix=None, today=None):
    """Markdown for INBOX.md (also printed); remembers every key in meta inbox_seen."""
    out = _project(project) / "qa-out"  # a typo must not create a stray folder
    items = list({x["key"]: x for x in inbox_items(data)}.values())  # a key listed twice (paged search) is one ticket
    try:
        old = [k for k in json.loads(meta(con, "inbox_seen") or "[]") if isinstance(k, str)]
    except (ValueError, TypeError):
        old = []
    seen = set(old)
    for x in items:
        x["new"] = x["key"] not in seen
    items.sort(key=lambda x: x["updated"], reverse=True)
    items.sort(key=lambda x: not x["new"])  # stable: NEW first, each group by updated desc
    new = [x for x in items if x["new"]]
    lines = [f"# Jira inbox", f"{today or datetime.now().strftime('%Y-%m-%d')} · {len(items)} open, {len(new)} new", ""]
    if items:
        lines += [row("New", "Key", "Summary", "Status", "Priority", "Updated"), "|---|---|---|---|---|---|"]
        lines += [row("NEW" if x["new"] else "", x["key"], x["summary"], x["status"], x["priority"], x["updated"][:10])
                  for x in items]
    else:
        lines.append("No open tickets assigned to you.")
    pick = [x["key"] for x in (new or items[:3])]
    p = str(prefix or "").strip().upper().rstrip("-")
    nums = [k[len(p) + 1:] if p and k.startswith(p + "-") else k for k in pick]
    lines += ["", f"Next: /qa-sdet:qa-ticket {' '.join(nums)}" if nums else "Next: nothing to test"]
    text = "\n".join(lines) + "\n"
    out.mkdir(exist_ok=True)
    _write(out / "INBOX.md", text)
    # remembered only once INBOX.md is written (a failed write keeps them NEW); today's keys are always kept, older
    # ones up to 5000 (a cap on sorted keys dropped the alphabetically last, so a big inbox stayed NEW forever)
    current = {x["key"] for x in items}
    with con:
        con.execute("BEGIN IMMEDIATE")  # re-read under the write lock: keys another inbox saved meanwhile stay seen
        try:
            old = [k for k in json.loads(meta(con, "inbox_seen") or "[]") if isinstance(k, str)]
        except (ValueError, TypeError):
            pass
        keep = [x["key"] for x in items] + [k for k in old if k not in current][:max(0, 5000 - len(items))]
        set_meta(con, "inbox_seen", json.dumps(keep))
    return text


# ---------- setup-permissions: allow rules so auto mode doesn't block the plugin's own commands ----------
# Auto mode drops Agent rules and wildcarded interpreter rules (`Bash(python3 *...)`), so qa-mem is allowed as the bare
# command: the plugin's bin/ folder is on the Bash tool's PATH while the plugin is enabled.
PERMISSION_RULES = [
    "Bash(qa-mem *)",
    "Bash(playwright-cli -s=qa *)", "Bash(playwright-cli -s=qa-login *)", "Bash(playwright-cli --version)",
    "Bash(command -v playwright-cli*)",
    "Bash(acli jira auth status*)", "Bash(acli jira workitem view *)", "Bash(acli jira workitem search *)",
    "Skill(qa-sdet:*)",
    # every skill/explorer reads it (hosts/URLs, no secrets). Read only: allowedHosts is the guard's trust root, so an
    # auto-allowed Edit/Write would let a prompt-injected agent widen it silently
    "Read(~/.config/qa-sdet/config.json)",
]


def merge_permissions(path, stamp=None):
    """Add missing PERMISSION_RULES to permissions.allow in a Claude Code settings file. Keeps every other key and the
    existing order, backs the file up first, writes atomically with its mode. Returns the rules added."""
    path = Path(os.path.realpath(Path(path).expanduser()))  # a symlinked settings.json (dotfiles) stays a link
    def no_constant(c):  # NaN / Infinity: Python reads them, Claude Code can't
        raise ValueError(f"non-standard number {c}")
    try:
        before = path.read_text(encoding="utf-8") if path.exists() else None
        settings = json.loads(before, parse_constant=no_constant) if before is not None else {}
    except (OSError, ValueError, RecursionError) as e:  # RecursionError: JSON nested thousands deep
        raise BadInput(f"setup-permissions: {path} isn't valid JSON ({type(e).__name__}: {short(str(e), 120)}); "
                       f"fix it first, nothing changed")
    perms = settings.get("permissions", {}) if isinstance(settings, dict) else None
    allow = perms.get("allow", []) if isinstance(perms, dict) else None
    if not isinstance(allow, list):
        raise BadInput(f"setup-permissions: {path} has no usable permissions.allow list; nothing changed")
    same = lambda r: re.sub(r"\s*([()])\s*", r"\1", " ".join(str(r).split()))  # `Bash( qa-mem *)` is that rule too
    have = {same(r) for r in allow}
    added = [r for r in PERMISSION_RULES if same(r) not in have]
    if not added:
        return []
    settings["permissions"] = {**perms, "allow": allow + added}
    try:  # serialise first: nothing is touched when this fails (a lone surrogate can't be written as UTF-8)
        text = json.dumps(settings, indent=2, ensure_ascii=False, allow_nan=False) + "\n"
        text.encode("utf-8")
    except (ValueError, UnicodeEncodeError) as e:
        raise BadInput(f"setup-permissions: {path} can't be written back as valid JSON ({e}); nothing changed")
    if before is not None and not os.access(path, os.W_OK):
        raise BadInput(f"setup-permissions: {path} is read-only; make it writable or add the rules by hand, "
                       f"nothing changed")
    mode = path.stat().st_mode & 0o7777 if before is not None else 0o600
    tmp = None
    try:
        if before is not None:
            import shutil
            base = f"{path.name}.bak-{stamp or datetime.now().strftime('%Y%m%d%H%M%S')}"
            bak, n = path.with_name(base), 2
            while bak.exists() or bak.is_symlink():  # two applies in one second: never overwrite the first backup
                bak, n = path.with_name(f"{base}-{n}"), n + 1
            shutil.copy2(path, bak)
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, mode)
        # Claude Code may have saved the file meanwhile (/permissions, /config): never drop its edit
        now_text = path.read_text(encoding="utf-8") if path.exists() else None
        if now_text != before:
            raise BadInput(f"setup-permissions: {path} changed while merging; run it again, nothing changed")
        os.replace(tmp, path)
    except OSError as e:
        raise BadInput(f"setup-permissions: can't write {path} ({e}); nothing changed")
    finally:
        if tmp:
            Path(tmp).unlink(missing_ok=True)
    return added


def _opts(args, flags=(), valued=(), multi=()):
    """{'--x': value or True, '--m': [values], '_': [positionals]} from --x v / --x=v / --flag; unknown options are
    BadInput."""
    out, it = {"_": []}, iter(args)
    for a in it:
        name, eq, val = a.partition("=")
        if name in valued or name in multi:
            v = val if eq else next(it, None)
            if v is None:
                raise BadOption(f"{name} needs a value")
            if name in multi:
                out.setdefault(name, []).append(v)
            elif name in out:  # last-wins would silently drop a value (--keys 1 --keys 2)
                raise BadOption(f"{name} given twice; give it once (comma-separate several keys)")
            else:
                out[name] = v
        elif a in flags:
            out[a] = True
        elif a.startswith("--"):
            raise BadOption(f"unknown option {a}")
        else:
            out["_"].append(a)
    return out


def _count(o, name, most=None):
    try:
        n = int(o[name]) if name in o else 0  # `--budget ""` is a mistake, not "unlimited"
    except (ValueError, TypeError):
        n = -1
    if n < 0:
        raise BadInput(f"{name} must be a whole number >= 0")
    if most is not None and n > most:
        raise BadInput(f"{name} must be at most {most}")
    return n


def wrapper_cmd(cmd, args):
    """The v0.4 commands that need no memory DB. Returns an exit code, or None for other commands."""
    if cmd == "keys":
        print(json.dumps(expand_keys(args, config().get("jiraKeyPrefix"))))
    elif cmd == "rundir":
        o = _opts(args, valued=("--keys", "--route", "--label", "--prefix"))
        if len(o["_"]) != 1 or sum(k in o for k in ("--keys", "--route", "--label")) != 1:
            raise BadInput("usage: qa-mem rundir <project> (--keys K1,K2 | --route <route> | --label <text>) [--prefix plan-]")
        keys = expand_keys([o["--keys"]], config().get("jiraKeyPrefix")) if "--keys" in o else None
        print(make_rundir(o["_"][0], run_label(keys, o.get("--route"), o.get("--label"), o.get("--prefix") or "")))
    elif cmd == "marker":
        o = _opts(args[1:], flags=("--faults",), valued=("--budget", "--minutes"))
        if not args or args[0] not in ("start", "stop") or len(o["_"]) != 1:
            raise BadInput("usage: qa-mem marker start <project> [--budget N] [--minutes M] [--faults] | marker stop <project>")
        if args[0] == "start":
            print(json.dumps(marker_start(o["_"][0], _count(o, "--budget"), _count(o, "--minutes", MARKER_HOURS * 60), o.get("--faults", False))))
        else:
            marker_stop(o["_"][0])
            print("marker removed")
    elif cmd == "browser-open":
        return browser_open(args)
    elif cmd == "login-ok":
        if args:
            raise BadInput("usage: qa-mem login-ok")
        ensure_profile_dir()
        _write(signed_in_stamp(), datetime.now().strftime("%Y-%m-%d %H:%M") + "\n")
        print("sign-in recorded: qa-mem doctor now reports the profile as signed in")
    elif cmd == "prune":
        if len(args) != 1:
            raise BadInput("usage: qa-mem prune <project>")
        print(f"pruned {prune(args[0])} old snapshot files")
    elif cmd == "annotate":
        o = _opts(args, valued=("--label",), multi=("--box",))
        if len(o["_"]) != 1 or not o.get("--box") or not o.get("--label"):
            raise BadInput("usage: qa-mem annotate <png> --box x,y,w,h [--box ...] --label <text>")
        boxes = [parse_box(b) for b in o["--box"]]
        png = evidence_png(o["_"][0])
        if not annotate(png, boxes, o["--label"]):
            print(NO_PILLOW)
        else:
            print(f"annotated {png}")
    elif cmd == "report":
        if len(args) != 1:
            raise BadInput("usage: qa-mem report <run dir>")
        print(write_report(args[0]))
    elif cmd == "setup-permissions":
        o = _opts(args, flags=("--apply",), valued=("--settings",))
        if o["_"]:
            raise BadInput("usage: qa-mem setup-permissions [--settings PATH] [--apply]")
        if not o.get("--apply"):
            print("\n".join(PERMISSION_RULES))
            return 0
        if "--settings" in o and not o["--settings"].strip():
            raise BadOption("--settings needs a path")  # an empty shell variable must not fall back to the real file
        added = merge_permissions(o.get("--settings") or "~/.claude/settings.json")
        print("added to permissions.allow:\n" + "\n".join(added) if added else "all rules already present; nothing changed")
    else:
        return None
    return 0


COMMANDS = {  # name -> arguments, for `qa-mem` (no args), `qa-mem <cmd> --help` and bad input
    "doctor": "", "browsers": "", "where": "", "card": "<route|page name>", "search": "<words> [-word to exclude]",
    "bugs": "[STATUS]", "hash": "<route> <symptom>", "bug-status": "<hash-prefix> <" + "|".join(sorted(STATUSES)) + ">",
    "stale": "<build>", "ingest": "<run.json>", "ingest-pending": "<dir>...", "code": "[route] | code --repos",
    "codemap-scan": "[--full] [--out DIR] <source folder>...", "codemap-forget": "<source folder>",
    "keys": "<number|KEY>...", "rundir": "<project> (--keys K1,K2 | --route <route> | --label <text>) [--prefix plan-]",
    "marker": "start <project> [--budget N] [--minutes M] [--faults] | marker stop <project>",
    "browser-open": "[--session qa|qa-login] [--headed] [<url>]", "login-ok": "", "prune": "<project>",
    "annotate": "<png> --box x,y,w,h [--box ...] --label <text>", "report": "<run dir>",
    "inbox": "<project> [--file F]", "setup-permissions": "[--settings PATH] [--apply]",
}
USAGE = "usage: qa-mem <command> [args]; commands:\n" + "\n".join(f"  qa-mem {c} {a}".rstrip() for c, a in COMMANDS.items())
# Commands that read their arguments as plain words: an option there is a typo (`stale --help` must not set the build
# to "--help"), so only these options pass. The others parse options with _opts, which rejects unknown ones; `hash`
# takes a symptom, which may hold "--" ("shows -- instead of 50").
PLAIN_ARGS = {"doctor": None, "browsers": None, "where": None, "init": None, "login-ok": None,  # None: no arguments
              "card": (), "search": (), "bugs": (), "bug-status": (), "stale": (), "ingest": (),
              "code": ("--repos",), "codemap-scan": ("--full", "--out"), "codemap-forget": (), "keys": (),
              "prune": (), "report": (), "ingest-pending": ()}  # the hook's paths never start with --


def usage_error(cmd, why=""):
    print(f"qa-mem: {why + '; ' if why else ''}usage: qa-mem {cmd} {COMMANDS.get(cmd, '')}".rstrip(), file=sys.stderr)
    return 2


def hook_input():
    """The hook's JSON on stdin (Claude Code sends it and closes stdin); {} when run by hand."""
    try:
        import select
        # 2 s: on a loaded machine the payload can come late, and missing stop_hook_active forces an extra round
        if sys.stdin is None or sys.stdin.isatty() or not select.select([sys.stdin], [], [], 2.0)[0]:
            return {}
        data = json.loads(sys.stdin.read() or "{}")
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError, TypeError):
        return {}


def main(argv):
    try:
        return _main(argv)
    except sqlite3.OperationalError as e:
        if "locked" not in str(e) and "busy" not in str(e):
            raise
        print(f"qa-mem: the memory DB {db_path()} stayed busy (another qa-mem or a run's hook is writing to it); "
              "the command did not finish: run it again in a minute", file=sys.stderr)
        return 1


def _main(argv):
    for stream in (sys.stdout, sys.stderr):  # a non-UTF-8 argument echoed back must not crash the print
        try:
            stream.reconfigure(errors="replace")
        except (AttributeError, ValueError):
            pass
    # bytes that aren't UTF-8 arrive as surrogates, which sqlite3 and print() refuse: make them U+FFFD
    argv = [a.encode("utf-8", "surrogateescape").decode("utf-8", "replace") for a in argv]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 2
    cmd, args = argv[0], argv[1:]
    if cmd not in COMMANDS and cmd != "init":
        print(f"qa-mem: unknown command {cmd!r}\n{USAGE}", file=sys.stderr)
        return 2
    if any(a in ("-h", "--help") for a in args):
        return usage_error(cmd)
    allowed = PLAIN_ARGS.get(cmd, ())
    if cmd in PLAIN_ARGS and allowed is None and args:
        return usage_error(cmd, f"{cmd} takes no arguments")
    bad = next((a for a in args if cmd in PLAIN_ARGS and re.match(r"--[A-Za-z]", a) and a.split("=")[0] not in allowed),
               None)
    if bad:
        return usage_error(cmd, f"unknown option {bad}")
    if cmd == "ingest-pending":  # runs from hooks: must never break the session
        for root in dict.fromkeys(os.path.realpath(a) for a in (args or ["qa-out"]) if a):  # cwd + project dir
            try:
                ingest_pending(root)
            except Exception as e:  # noqa: BLE001
                print(f"qa-mem: {e}", file=sys.stderr)
        if PARKED and not hook_input().get("stop_hook_active"):
            # Exit 2 from a Stop/SubagentStop hook shows this to the agent that just wrote the file, once.
            refs = Path(__file__).resolve().parent.parent / "references"
            print(f"qa-sdet memory could not save this (file(s) below). For each one YOU wrote this run: fix the field the "
                  f"error names (rules: {refs / 'run-json.md'} for run JSON, {refs / 'code-map.md'} for code-map-*.json) "
                  "and rewrite the whole file; it is re-read automatically. A file you did not write belongs to another "
                  "agent: leave it.\n" + "\n".join(PARKED), file=sys.stderr)
            return 2
        return 0
    if cmd == "doctor":
        return 1 if doctor() else 0
    try:
        code_ = wrapper_cmd(cmd, args)
        if code_ is not None:
            return code_
        if cmd == "inbox":
            o = _opts(args, valued=("--file",))
            if len(o["_"]) != 1:
                raise BadInput("usage: qa-mem inbox <project> [--file F]")
            try:
                data = json.loads(Path(o["--file"]).read_text() if o.get("--file") else sys.stdin.read())
            except (OSError, ValueError, RecursionError) as e:  # RecursionError: garbage nested too deep
                raise BadInput(f"inbox: can't read Jira JSON ({e})")
            items = inbox_items(data)  # bad input fails before the DB is opened
            con = connect()
            try:
                print(inbox(con, o["_"][0], items, config().get("jiraKeyPrefix")), end="")
            finally:
                con.close()
            return 0
    except BadOption as e:
        return usage_error(cmd, str(e))
    except BadInput as e:
        print(f"qa-mem: {e}", file=sys.stderr)
        return 2
    if cmd == "browsers":  # what C1 offers when it asks which browser to use
        for name, (ok, how) in installed_browsers().items():
            print(f"{name:8} {'installed' if ok else 'missing  '}  {how}")
        print("(firefox and webkit mean Playwright's own builds; a system Firefox can't be driven)")
        return 0
    if cmd == "hash" and len(args) >= 2:  # same normalisation as ingest, so draft and DB hashes match
        print(bug_hash(norm_route(args[0]), cap(redact(" ".join(args[1:])))))
        return 0
    if cmd in ("where", "init"):
        print(db_path())
        if cmd == "where":
            return 0
    con = connect()
    try:
        return run_cmd(con, cmd, args)
    finally:
        con.close()


def run_cmd(con, cmd, args):
    if cmd == "init":
        pass
    elif cmd == "card" and args:
        print(card(con, " ".join(args)))
    elif cmd == "code":
        print(code(con, " ".join(args)))
    elif cmd == "codemap-forget" and args:
        n = codemap_forget(con, " ".join(args))
        if n is None:
            print(f"no mapped source folder '{' '.join(args)}'; give one exactly as `qa-mem code --repos` lists it",
                  file=sys.stderr)
            return 2
        print(f"removed {n} code-map rows for {' '.join(args)}")
    elif cmd == "codemap-scan":
        full, out, paths, it = False, "qa-out/init", [], iter(args)
        for a in it:
            if a == "--full":
                full = True
            elif a == "--out":
                out = next(it, out)
            elif a.startswith("--out="):
                out = a.split("=", 1)[1] or out
            else:
                paths.append(a)
        if not paths:
            print("give the source folder(s) to scan, e.g. qa-mem codemap-scan ~/work/traffic-ui ~/work/traffic-api")
            return 2
        print(json.dumps(codemap_scan(con, paths, out, full), indent=1))
    elif cmd == "search" and args:
        print(search(con, " ".join(args)))
    elif cmd == "bugs":
        status = args[0].upper() if args else "OPEN"
        if status not in STATUSES:
            print(f"unknown status '{args[0]}'; use one of {sorted(STATUSES)}")
            return 2
        print(bugs(con, status))
    elif cmd == "bug-status" and len(args) == 2:
        prefix, status = args[0].lower(), args[1].upper()
        if not re.fullmatch(r"[0-9a-f]{4,12}", prefix) or status not in STATUSES:
            print(f"need a hex hash prefix (4-12 chars) and a status in {sorted(STATUSES)}")
            return 2
        hits = [r[0] for r in con.execute("SELECT hash FROM bugs WHERE substr(hash, 1, ?)=?", (len(prefix), prefix))]
        if len(hits) != 1:  # an ambiguous prefix must not change several bugs at once
            print(f"{len(hits)} bugs match '{prefix}'" + (": " + ", ".join(hits[:10]) if hits else "") + "; give one hash")
            return 1
        with con:
            con.execute("UPDATE bugs SET status=? WHERE hash=?", (status, hits[0]))
            # reopened, but its run files no longer list it (they were rewritten without it): it is no bug to track
            gone = con.execute("DELETE FROM bugs WHERE hash=? AND status='OPEN' AND seen_count=0 AND NOT EXISTS "
                               "(SELECT 1 FROM sightings WHERE hash=?)", (hits[0], hits[0])).rowcount
        print(f"removed {hits[0]}: no run lists this bug any more" if gone else f"updated {hits[0]} -> {status}")
    elif cmd == "ingest" and args:
        # Same scrubbing as the hook path, so secrets stay out of the DB and hashes match `qa-mem hash`.
        try:
            ingest(con, redact_json(json.loads(Path(args[0]).read_text())), run_dir=Path(args[0]).resolve().parent,
                   src=Path(args[0]).resolve())
        except (OSError, ValueError, RecursionError) as e:  # ValueError: not JSON, or a field ingest rejects
            print(f"qa-mem: ingest: can't save {args[0]} ({type(e).__name__}: {short(e, 200)})", file=sys.stderr)
            return 2
        print("ingested")
    elif cmd == "stale" and args:
        build = cap(" ".join(args))  # normalised like ingest, so it matches stored builds
        if not build or build.lower() == UNKNOWN:
            print("give the deployed build, e.g. qa-mem stale 1.43.0")
            return 2
        with con:
            set_meta(con, "build", build)
            set_meta(con, "build_ts", now())
            for table in ("facts", "locators"):
                con.execute(f"UPDATE {table} SET stale=1 WHERE page IN (SELECT route FROM pages WHERE build!=?)",
                            (build,))
                # a corrected build (stale 1.44 then stale 1.43): what was verified on it is current again
                con.execute(f"UPDATE {table} SET stale=0 WHERE build=? AND page IN "
                            f"(SELECT route FROM pages WHERE build=?)", (build, build))
        print(f"current build set to {build}; older knowledge marked stale")
    else:
        return usage_error(cmd)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
